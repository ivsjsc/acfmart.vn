rules_version = '2';
service cloud.firestore {

  /* ─── Role helpers ─── */
  function isAuth() {
    return request.auth != null;
  }

  function userDocPath(uid) {
    return /databases/$(database)/documents/users/$(uid);
  }

  function callerHasProfile() {
    return isAuth() && exists(userDocPath(request.auth.uid));
  }

  function callerRole() {
    return callerHasProfile()
      ? get(userDocPath(request.auth.uid)).data.get('role', 'customer')
      : 'guest';
  }

  function isAdmin() {
    return callerHasProfile() && callerRole() == 'admin';
  }

  // Helper to check if request is from an admin
  function isAdminRequest() {
    return isAuth() && request.auth.token.admin == true;
  }

  // Helper to check if request is from data owner or admin
  function isOwnerOrAdmin(userId) {
    return isAuth() && (request.auth.uid == userId || isAdminRequest());
  }

  match /databases/{database}/documents {

    // ─── User profiles ────────────────────────────────────────────────────
    // Only admins can read all user data
    match /users/{userId} {
      allow read: if isAdminRequest();
      
      // Allow users to read their own data
      allow read: if isAuth() && request.auth.uid == userId;
      
      // Only admins can create/update/delete users
      allow create, update, delete: if isAdminRequest();
    }

    // Allow admin to read all user data
    match /users/{document} {
      allow read: if isAdminRequest();
    }

    // ─── User profiles ────────────────────────────────────────────────────
    match /userProfiles/{userId} {
      allow read: if isAdminRequest() || request.auth.uid == userId;
      allow create: if isAdminRequest();
      allow update: if isAdminRequest() || request.auth.uid == userId;
      allow delete: if isAdminRequest();
    }

    // ─── Products ─────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdminRequest();
    }

    // ─── Orders ───────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdminRequest() 
        || (isAuth() && (
            request.auth.uid == resource.data.customerId ||
            request.auth.uid == resource.data.shopId
          ));
      
      allow create: if isAuth() && request.auth.uid == resource.data.customerId;
      allow update, delete: if isAdminRequest();
    }

    // ─── Carts ────────────────────────────────────────────────────────────
    match /carts/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ─── Vendors (seller registration) ─────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if isAdminRequest() || request.auth.uid == vendorId;
      allow create: if isAdminRequest();
      allow update: if isAdminRequest() || request.auth.uid == vendorId;
      allow delete: if isAdminRequest();
    }

    // ─── Audit logs (append-only; actor_id phải là chính user đăng nhập) ───
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isAuth()
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.keys().hasAll([
          'action', 'actor_email', 'actor_role', 'target_type', 'target_id', 'details'
        ]);
      allow update, delete: if false;
    }

    // ─── Notifications ────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if isAuth() && resource.data.user_id == request.auth.uid;
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ─── Counterfeit reports ──────────────────────────────────────────────
    match /counterfeitReports/{reportId} {
      allow read: if isAdminRequest();
      allow create: if isAuth();
      allow update, delete: if isAdminRequest();
      
      // Allow admin to modify specific fields
      match /created_at {
        allow read, write: if isAdminRequest();
      }
      
      match /status {
        allow read, write: if isAdminRequest();
      }
    }

    // ─── Platform settings (admin UI — chỉ admin ghi) ─────────────────────
    match /systemSettings/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdminOnly();
    }

    // ─── Shop profiles ────────────────────────────────────────────────────
    match /shopProfiles/{shopId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == shopId;
      allow update: if isAuth() && (isAdminOnly() || request.auth.uid == shopId);
      allow delete: if isAdminOnly();
    }

    // ─── Product verifications ────────────────────────────────────────────
    match /productVerifications/{verificationId} {
      allow read: if isAuth();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdminOnly();
    }

    // ─── Payment methods ──────────────────────────────────────────────────
    match /paymentMethods/{documentId} {
      allow read: if isAuth()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── Product reviews ──────────────────────────────────────────────────
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAdminRequest() 
        || (isAuth() && request.auth.uid == resource.data.userId);
    }

    // ─── Affiliate referrals ──────────────────────────────────────────────
    match /affiliateReferrals/{referralId} {
      allow read: if isAuth()
        && (isAdminOnly() || resource.data.affiliateId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth()
        && (isAdminOnly() || resource.data.affiliateId == request.auth.uid);
      allow delete: if isAdminOnly();
    }

    // ─── Escrow payments ──────────────────────────────────────────────────
    match /escrowPayments/{paymentId} {
      allow read: if isAuth()
        && (isStaff()
            || resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if isAdminOnly();
    }

    // ─── Seller applications (legacy) ─────────────────────────────────────
    match /sellerApplications/{applicationId} {
      allow read: if isAuth()
        && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ─── Conversations / Chat ─────────────────────────────────────────────
    match /conversations/{convoId} {
      allow read: if isAdminRequest() 
        || (isAuth() && request.auth.uid in resource.data.participants);
      
      allow create: if isAuth();
      allow update, delete: if isAdminRequest();
      
      match /messages/{messageId} {
        allow read: if isAdminRequest() 
          || (isAuth() && request.auth.uid in resource.data.participants);
        
        allow create: if isAuth();
        allow update, delete: if isAdminRequest();
      }
    }

    // ─── Banners (homepage slider) ────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdminRequest();
    }

    // ─── QR Verification Results ──────────────────────────────────────────
    match /qr_verification_results/{resultId} {
      allow read: if isAdminRequest() 
        || (isAuth() && request.auth.uid == resource.data.owner_id);
      allow create, update, delete: if isAdminRequest();
    }
    
    // ─── Affiliate referrals ──────────────────────────────────────────────
    match /affiliateReferrals/{referralId} {
      allow read: if isAdminRequest() 
        || (isAuth() && request.auth.uid == resource.data.affiliateId);
      allow create: if isAuth();
      allow update: if isAdminRequest() 
        || (isAuth() && request.auth.uid == resource.data.affiliateId);
      allow delete: if isAdminRequest();
    }
    
    // ─── Escrow payments ──────────────────────────────────────────────────
    match /escrowPayments/{paymentId} {
      allow read: if isAdminRequest() 
        || (isAuth() && (
            request.auth.uid == resource.data.buyerId ||
            request.auth.uid == resource.data.sellerId
          ));
      allow create, update, delete: if isAdminRequest();
    }
    
    // ─── Default deny ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
