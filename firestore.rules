rules_version = '2';
service cloud.firestore {

  // ════════════════════════════════════════════════════════════════════
  // SECTION 1 · AUTH & ROLE HELPERS
  // ════════════════════════════════════════════════════════════════════
  // Roles can come from EITHER:
  //   1) Custom claims set via Firebase Admin SDK (fast, no extra read)
  //   2) /users/{uid}.role document field (fallback for users provisioned
  //      via Firestore directly without Cloud Function side-effects)
  // We prefer custom claim; if absent we read the user doc. Document reads
  // billed against the rules quota are cached per request.

  function authedUid() {
    return request.auth.uid;
  }

  function claimRole() {
    return request.auth.token.role;
  }

  function docRole(db) {
    return get(/databases/$(db)/documents/users/$(authedUid())).data.role;
  }

  // Role checks are case-insensitive so legacy docs persisted as "Owner",
  // "ADMIN", etc. still satisfy the rule. Custom claims set via Admin SDK
  // are normally lowercase, but tolerate variants for safety.
  function hasClaim(role) {
    return request.auth != null &&
      claimRole() is string &&
      claimRole().lower() == role;
  }

  function claimRoleValue() {
    return claimRole() is string ? claimRole().lower() : '';
  }

  function hasDocRole(db, role) {
    return request.auth != null &&
      exists(/databases/$(db)/documents/users/$(authedUid())) &&
      docRole(db) is string &&
      docRole(db).lower() == role;
  }

  function isAdmin(db) {
    return hasClaim('owner') || hasClaim('admin') ||
      hasDocRole(db, 'owner') || hasDocRole(db, 'admin');
  }

  function isOwner(db) {
    return hasClaim('owner') || hasDocRole(db, 'owner');
  }

  function isModerator(db) {
    return hasClaim('owner') || hasClaim('admin') || hasClaim('moderator') ||
      hasDocRole(db, 'owner') || hasDocRole(db, 'admin') || hasDocRole(db, 'moderator');
  }

  function isManager(db) {
    return hasClaim('manager') || hasDocRole(db, 'manager');
  }

  // Role guards below treat "owner" case-insensitively so legacy docs with
  // mixed case still protect Owner records from admin-level mutations.
  function roleValue(data) {
    return data.role is string ? data.role.lower() : '';
  }

  function isAdminUserUpdate(db) {
    return isAdmin(db) &&
      roleValue(resource.data) != 'owner' &&
      roleValue(request.resource.data) != 'owner';
  }

  function changedOnly(fields) {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
  }

  function unchangedAll(fields) {
    return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
  }

  // ════════════════════════════════════════════════════════════════════
  // SECTION 2 · GENERIC OWNERSHIP & DIFF HELPERS
  // ════════════════════════════════════════════════════════════════════
  // These wrap the most-repeated ownership patterns so policy intent reads
  // declaratively (`ownsField('userId')` instead of inline equality).
  //
  //   ownsField(field)         → existing doc's `field` matches caller's uid.
  //                              Use on update/delete to assert the caller
  //                              owns the document being mutated.
  //   incomingOwnsField(field) → incoming doc's `field` matches caller's uid.
  //                              Use on create to assert the new doc names
  //                              the caller as owner.
  //   keepsField(field)        → incoming doc keeps the same value for
  //                              `field` (immutable on update).
  //   isParticipant(field)     → caller's uid is in resource list `field`
  //                              (conversations, group threads, etc.).
  //   publicRead()             → marker for collections intentionally
  //                              world-readable. Use only where docs are
  //                              guaranteed PII-free.

  function ownsField(field) {
    return request.auth != null && resource.data[field] == request.auth.uid;
  }

  function incomingOwnsField(field) {
    return request.auth != null && request.resource.data[field] == request.auth.uid;
  }

  function keepsField(field) {
    return request.resource.data[field] == resource.data[field];
  }

  function isParticipant(field) {
    return request.auth != null && request.auth.uid in resource.data[field];
  }

  function publicRead() {
    return true;
  }

  // ════════════════════════════════════════════════════════════════════
  // SECTION 3 · DOMAIN VALIDATORS
  // ════════════════════════════════════════════════════════════════════
  // Schema + transition validators grouped by domain. Each helper
  // returns a single boolean expression so rule blocks below stay flat
  // and read like a policy list rather than nested boolean trees.

  // ─── Vendor profile ──────────────────────────────────────────────────
  function isVendorOwnerProfileUpdate() {
    return resource.data.firebase_uid == request.auth.uid &&
      resource.data.status == 'active' &&
      request.resource.data.firebase_uid == resource.data.firebase_uid &&
      request.resource.data.status == resource.data.status &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'shop_name',
        'shop_slug',
        'shop_logo',
        'shop_banner',
        'description',
        'owner_name',
        'owner_email',
        'owner_phone',
        'pickup_address',
        'pickup_warehouses',
        'bank_name',
        'bank_account_number',
        'bank_account_holder',
        'updated_at'
      ]) &&
      nonEmptyString(request.resource.data.owner_name, 120) &&
      request.resource.data.owner_phone is string &&
      request.resource.data.owner_phone.matches('^[0-9+()\\-\\s]{8,20}$') &&
      request.resource.data.pickup_address is map &&
      request.resource.data.pickup_address.keys().hasOnly([
        'full_address',
        'ward',
        'district',
        'city'
      ]) &&
      nonEmptyString(request.resource.data.pickup_address.full_address, 240) &&
      nonEmptyString(request.resource.data.pickup_address.ward, 120) &&
      nonEmptyString(request.resource.data.pickup_address.district, 120) &&
      nonEmptyString(request.resource.data.pickup_address.city, 120) &&
      (
        !('pickup_warehouses' in request.resource.data) ||
        isValidProductWarehouses(request.resource.data.pickup_warehouses)
      );
  }

  function isValidOptionalShippingCoordinate(data, field, minValue, maxValue) {
    return !(field in data) ||
      data[field] == null ||
      (data[field] is number && data[field] >= minValue && data[field] <= maxValue);
  }

  function isValidShippingAddress(data) {
    return data is map &&
      data.keys().hasOnly([
        'name',
        'phone',
        'address',
        'ward',
        'district',
        'city',
        'latitude',
        'longitude'
      ]) &&
      nonEmptyString(data.name, 120) &&
      data.phone is string &&
      data.phone.matches('^[0-9+()\\-\\s]{8,20}$') &&
      nonEmptyString(data.address, 240) &&
      nonEmptyString(data.ward, 120) &&
      nonEmptyString(data.district, 120) &&
      nonEmptyString(data.city, 120) &&
      isValidOptionalShippingCoordinate(data, 'latitude', -90, 90) &&
      isValidOptionalShippingCoordinate(data, 'longitude', -180, 180);
  }

  function isValidShippingOrigin(data) {
    return data is map &&
      data.keys().hasOnly([
        'warehouseId',
        'warehouseName',
        'contactName',
        'contactPhone',
        'fullAddress',
        'ward',
        'district',
        'city',
        'latitude',
        'longitude',
        'routeLabel',
        'distanceKm',
        'selectionReason'
      ]) &&
      nonEmptyString(data.warehouseId, 120) &&
      nonEmptyString(data.warehouseName, 120) &&
      nonEmptyString(data.contactName, 120) &&
      data.contactPhone is string &&
      data.contactPhone.matches('^[0-9+()\\-\\s]{8,20}$') &&
      nonEmptyString(data.fullAddress, 240) &&
      nonEmptyString(data.ward, 120) &&
      nonEmptyString(data.district, 120) &&
      nonEmptyString(data.city, 120) &&
      isValidOptionalShippingCoordinate(data, 'latitude', -90, 90) &&
      isValidOptionalShippingCoordinate(data, 'longitude', -180, 180) &&
      nonEmptyString(data.routeLabel, 240) &&
      (
        !('distanceKm' in data) ||
        data.distanceKm == null ||
        (data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 10000)
      ) &&
      data.selectionReason in ['default', 'address-match', 'nearest'];
  }

  // ─── Order creation (customer) ───────────────────────────────────────
  function isValidInitialOrder() {
    return request.resource.data.keys().hasOnly([
        'code',
        'parentCode',
        'customerId',
        'customerEmail',
        'customerName',
        'customerPhone',
        'shopId',
        'shopName',
        'status',
        'paymentStatus',
        'paymentMethod',
        'shippingMethod',
        'shippingProviderId',
        'shippingProviderName',
        'shippingServiceCode',
        'shippingOrigin',
        'shippingFee',
        'codFee',
        'subtotal',
        'total',
        'items',
        'shippingAddress',
        'customerNote',
        'trackingNumber',
        'timeline',
        'created_at',
        'updated_at'
      ]) &&
      request.resource.data.keys().hasAll([
        'code',
        'parentCode',
        'customerId',
        'customerName',
        'customerPhone',
        'shopId',
        'shopName',
        'status',
        'paymentStatus',
        'paymentMethod',
        'shippingMethod',
        'shippingOrigin',
        'shippingFee',
        'codFee',
        'subtotal',
        'items',
        'shippingAddress',
        'timeline',
        'total',
        'created_at',
        'updated_at'
      ]) &&
      request.resource.data.code is string &&
      request.resource.data.parentCode is string &&
      request.resource.data.customerId == request.auth.uid &&
      (!('customerEmail' in request.resource.data) || optionalString(request.resource.data.customerEmail, 180)) &&
      nonEmptyString(request.resource.data.customerName, 180) &&
      nonEmptyString(request.resource.data.customerPhone, 60) &&
      request.resource.data.shopId is string &&
      request.resource.data.shopName is string &&
      request.resource.data.paymentMethod is string &&
      request.resource.data.shippingMethod is string &&
      (!('shippingProviderId' in request.resource.data) || optionalString(request.resource.data.shippingProviderId, 80)) &&
      (!('shippingProviderName' in request.resource.data) || optionalString(request.resource.data.shippingProviderName, 120)) &&
      (!('shippingServiceCode' in request.resource.data) || optionalString(request.resource.data.shippingServiceCode, 120)) &&
      isValidShippingOrigin(request.resource.data.shippingOrigin) &&
      nonNegativeNumber(request.resource.data.shippingFee) &&
      nonNegativeNumber(request.resource.data.codFee) &&
      nonNegativeNumber(request.resource.data.subtotal) &&
      request.resource.data.items is list &&
      request.resource.data.items.size() > 0 &&
      request.resource.data.items.size() <= 100 &&
      isValidShippingAddress(request.resource.data.shippingAddress) &&
      (!('customerNote' in request.resource.data) || optionalString(request.resource.data.customerNote, 1000)) &&
      (!('trackingNumber' in request.resource.data) || optionalString(request.resource.data.trackingNumber, 120)) &&
      request.resource.data.timeline is list &&
      request.resource.data.timeline.size() > 0 &&
      request.resource.data.timeline.size() <= 20 &&
      nonNegativeNumber(request.resource.data.total) &&
      request.resource.data.total <= 100000000 &&
      request.resource.data.created_at is timestamp &&
      request.resource.data.updated_at is timestamp &&
      (
        (request.resource.data.paymentStatus == 'pending' &&
          request.resource.data.paymentMethod != 'cod' &&
          request.resource.data.status == 'payment_pending') ||
        (request.resource.data.paymentStatus == 'cod' &&
          request.resource.data.paymentMethod == 'cod' &&
          request.resource.data.status == 'awaiting_confirm')
      );
  }

  function isAuth() {
    return request.auth != null;
  }

  // ─── Social feed (community posts + comments) ────────────────────────
  function isValidSocialPostCreate() {
    return isAuth() &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.authorProfileType in ['user', 'shop'] &&
      request.resource.data.authorProfileId is string &&
      request.resource.data.authorProfileId.size() > 0 &&
      request.resource.data.type in ['status', 'question', 'product_share'] &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 5000 &&
      request.resource.data.authorName is string &&
      (!('authorBadgeLabel' in request.resource.data) ||
        request.resource.data.authorBadgeLabel == null ||
        request.resource.data.authorBadgeLabel is string) &&
      request.resource.data.likeCount == 0 &&
      request.resource.data.commentCount == 0 &&
      request.resource.data.shareCount == 0 &&
      request.resource.data.likedBy is list &&
      request.resource.data.likedBy.size() == 0 &&
      (
        (request.resource.data.type == 'product_share' &&
          isValidSocialProductSnapshot()) ||
        (request.resource.data.type != 'product_share' &&
          request.resource.data.product == null)
      );
  }

  function isValidSocialProductSnapshot() {
    return request.resource.data.product is map &&
      request.resource.data.product.keys().hasOnly([
        'id',
        'handle',
        'title',
        'image',
        'price',
        'shopName'
      ]) &&
      request.resource.data.product.id is string &&
      request.resource.data.product.id.size() > 0 &&
      request.resource.data.product.handle is string &&
      request.resource.data.product.handle.size() > 0 &&
      request.resource.data.product.title is string &&
      request.resource.data.product.title.size() > 0 &&
      request.resource.data.product.title.size() <= 200 &&
      request.resource.data.product.price is number &&
      request.resource.data.product.price >= 0;
  }

  function isSocialPostAuthorUpdate() {
    return isAuth() &&
      resource.data.authorId == request.auth.uid &&
      request.resource.data.authorId == resource.data.authorId &&
      request.resource.data.type == resource.data.type &&
      changedOnly(['content', 'updated_at']) &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 5000;
  }

  function isSocialPostLikeUpdate() {
    return isAuth() &&
      changedOnly(['likedBy', 'likeCount', 'updated_at']) &&
      request.resource.data.likedBy is list &&
      request.resource.data.likeCount is number &&
      request.resource.data.likeCount >= 0 &&
      request.resource.data.likeCount == request.resource.data.likedBy.size() &&
      (
        (!resource.data.likedBy.hasAll([request.auth.uid]) &&
          request.resource.data.likedBy.hasAll([request.auth.uid]) &&
          request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
          request.resource.data.likeCount == resource.data.likeCount + 1) ||
        (resource.data.likedBy.hasAll([request.auth.uid]) &&
          !request.resource.data.likedBy.hasAll([request.auth.uid]) &&
          request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
          request.resource.data.likeCount == resource.data.likeCount - 1)
      );
  }

  function isSocialPostShareUpdate() {
    return isAuth() &&
      changedOnly(['shareCount', 'updated_at']) &&
      request.resource.data.shareCount is number &&
      request.resource.data.shareCount == resource.data.shareCount + 1;
  }

  function isSocialPostCommentCounterUpdate() {
    return isAuth() &&
      changedOnly(['commentCount', 'updated_at']) &&
      request.resource.data.commentCount is number &&
      request.resource.data.commentCount == resource.data.commentCount + 1;
  }

  function isValidSocialCommentCreate(postId) {
    return isAuth() &&
      request.resource.data.postId == postId &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.authorProfileType in ['user', 'shop'] &&
      request.resource.data.authorProfileId is string &&
      request.resource.data.authorProfileId.size() > 0 &&
      request.resource.data.authorName is string &&
      (!('authorBadgeLabel' in request.resource.data) ||
        request.resource.data.authorBadgeLabel == null ||
        request.resource.data.authorBadgeLabel is string) &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 2000;
  }

  function isSocialCommentAuthorUpdate() {
    return isAuth() &&
      resource.data.authorId == request.auth.uid &&
      changedOnly(['content', 'updated_at']) &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 2000;
  }

  // ─── Conversations / direct chat ─────────────────────────────────────
  function isValidConversationCreate() {
    return isAuth() &&
      request.resource.data.type in ['direct', 'shop', 'support', 'aivy'] &&
      request.resource.data.participants is list &&
      request.resource.data.participants.size() >= 2 &&
      request.resource.data.participants.size() <= 10 &&
      request.auth.uid in request.resource.data.participants &&
      request.resource.data.partyName is string &&
      request.resource.data.partyName.size() > 0 &&
      request.resource.data.partyName.size() <= 120 &&
      (!('blockedBy' in request.resource.data) ||
        request.resource.data.blockedBy is list);
  }

  function isConversationParticipant(db, convoId) {
    return isAuth() &&
      exists(/databases/$(db)/documents/conversations/$(convoId)) &&
      request.auth.uid in get(/databases/$(db)/documents/conversations/$(convoId)).data.participants;
  }

  function isValidMessageCreate(db, convoId) {
    return isConversationParticipant(db, convoId) &&
      (
        !('blockedBy' in get(/databases/$(db)/documents/conversations/$(convoId)).data) ||
        get(/databases/$(db)/documents/conversations/$(convoId)).data.blockedBy.size() == 0
      ) &&
      request.resource.data.senderId == request.auth.uid &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 4000;
  }

  // ─── Public profile mirrors (no PII) ─────────────────────────────────
  function isValidPublicProfile(data) {
    return data.keys().hasOnly([
        'displayName',
        'avatar',
        'role',
        'isVerified',
        'hasApprovedShop',
        'shopId',
        'bio',
        'affiliate_slug',
        'affiliate_page_enabled',
        'affiliate_banner_url',
        'affiliate_showcase',
        'origin',
        'publicAddress',
        'joinedAt',
        'createdAt',
        'updatedAt'
      ]) &&
      data.displayName is string &&
      data.displayName.size() > 0 &&
      data.displayName.size() <= 120 &&
      optionalString(data.avatar, 1000) &&
      data.role in ['customer', 'seller', 'carrier', 'moderator', 'admin', 'owner'] &&
      data.isVerified is bool &&
      data.hasApprovedShop is bool &&
      optionalString(data.shopId, 160) &&
      optionalString(data.bio, 1000) &&
      (!('affiliate_slug' in data) ||
        (data.affiliate_slug is string &&
          data.affiliate_slug.matches('^[a-z0-9](?:[a-z0-9-]{1,58}[a-z0-9])?$'))) &&
      (!('affiliate_page_enabled' in data) || data.affiliate_page_enabled is bool) &&
      optionalString(data.affiliate_banner_url, 1000) &&
      (!('affiliate_showcase' in data) || isValidAffiliateShowcaseConfig(data.affiliate_showcase)) &&
      optionalString(data.origin, 200) &&
      optionalString(data.publicAddress, 300);
  }

  function isValidPublicAffiliateShowcaseLink(data) {
    return data.keys().hasOnly([
        'short_code',
        'title',
        'target_url',
        'target_type',
        'target_id',
        'product_image',
        'product_price',
        'commission_bps',
        'showcase_order',
        'showcase_visible',
        'status',
        'clicks',
        'unique_clicks',
        'conversions',
        'total_commission',
        'last_click_at',
        'created_at',
        'updated_at'
      ]) &&
      nonEmptyString(data.short_code, 80) &&
      optionalString(data.title, 180) &&
      data.target_url is string &&
      data.target_url.size() <= 1000 &&
      (data.target_url.matches('^https://.*') || data.target_url.matches('^http://.*')) &&
      data.target_type in ['product', 'shop', 'category', 'campaign', 'home'] &&
      optionalString(data.target_id, 180) &&
      (!('product_image' in data) ||
        data.product_image == null ||
        (data.product_image is string && data.product_image.size() <= 1000)) &&
      (!('product_price' in data) ||
        data.product_price == null ||
        (data.product_price is number && data.product_price >= 0)) &&
      (data.commission_bps == null ||
        (data.commission_bps is number &&
          data.commission_bps >= 0 &&
          data.commission_bps <= 10000)) &&
      (!('showcase_order' in data) ||
        data.showcase_order == null ||
        (data.showcase_order is number && data.showcase_order >= 0)) &&
      (!('showcase_visible' in data) || data.showcase_visible is bool) &&
      data.status in ['active', 'paused', 'pending', 'expired'] &&
      data.clicks is number &&
      data.clicks >= 0 &&
      data.unique_clicks is number &&
      data.unique_clicks >= 0 &&
      data.conversions is number &&
      data.conversions >= 0 &&
      data.total_commission is number &&
      data.total_commission >= 0 &&
      (data.last_click_at == null || data.last_click_at is timestamp) &&
      data.created_at is timestamp &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function isValidAffiliateShowcaseConfig(data) {
    return data is map &&
      data.keys().hasOnly([
        'banner',
        'avatar',
        'bio',
        'links',
        'stats',
        'contact'
      ]) &&
      (!('banner' in data) || data.banner is bool) &&
      (!('avatar' in data) || data.avatar is bool) &&
      (!('bio' in data) || data.bio is bool) &&
      (!('links' in data) || data.links is bool) &&
      (!('stats' in data) || data.stats is bool) &&
      (!('contact' in data) || data.contact is bool);
  }

  function isValidPublicShopProfile(data) {
    return data.ownerUid is string &&
      data.shopName is string &&
      data.shopName.size() > 0 &&
      data.shopName.size() <= 160 &&
      data.status in ['pending', 'active', 'suspended', 'rejected'] &&
      data.kycLevel in ['none', 'basic', 'verified', 'premium'] &&
      optionalString(data.shopLogo, 1000) &&
      optionalString(data.shopBanner, 1000) &&
      optionalString(data.description, 4000);
  }

  // ─── User mirrors ───────────────────────────────────────────────────
  function privateUserRole(db, userId) {
    return exists(/databases/$(db)/documents/users/$(userId))
      ? roleValue(get(/databases/$(db)/documents/users/$(userId)).data)
      : '';
  }

  function requestRoleMatchesClaim(data) {
    return claimRoleValue() != '' &&
      data.role is string &&
      data.role.lower() == claimRoleValue();
  }

  function hasProfileName(data) {
    return (
        ('name' in data) &&
        nonEmptyString(data.name, 120)
      ) ||
      (
        ('displayName' in data) &&
        nonEmptyString(data.displayName, 120)
      );
  }

  function isValidPrivateUserBase(data) {
    return data.keys().hasOnly([
        'email',
        'name',
        'displayName',
        'phone',
        'birth_date',
        'birthday',
        'avatar',
        'role',
        'auth_provider',
        'auth_providers',
        'last_auth_provider',
        'primary_auth_provider',
        'profile_sources',
        'address',
        'note',
        'disabled',
        'zalo_id',
        'seller_vendor_id',
        'shop_name',
        'shop_logo',
        'shop_banner',
        'created_at',
        'createdAt',
        'updated_at',
        'updatedAt',
        'last_login_at',
        'lastLoginAt'
      ]) &&
      data.email is string &&
      data.email.size() <= 180 &&
      hasProfileName(data) &&
      optionalString(data.phone, 30) &&
      optionalDateString(data.birth_date) &&
      optionalDateString(data.birthday) &&
      optionalString(data.avatar, 1000) &&
      data.role is string &&
      data.role.lower() in ['customer', 'seller', 'carrier', 'moderator', 'manager', 'admin', 'owner'] &&
      optionalString(data.auth_provider, 60) &&
      optionalString(data.last_auth_provider, 60) &&
      optionalString(data.primary_auth_provider, 60) &&
      (!('auth_providers' in data) || data.auth_providers is list) &&
      (!('profile_sources' in data) || data.profile_sources is map) &&
      optionalString(data.address, 300) &&
      optionalString(data.note, 1000) &&
      (!('disabled' in data) || data.disabled is bool) &&
      (!('zalo_id' in data) || optionalString(data.zalo_id, 120)) &&
      (!('seller_vendor_id' in data) || optionalString(data.seller_vendor_id, 180)) &&
      (!('shop_name' in data) || optionalString(data.shop_name, 160)) &&
      (!('shop_logo' in data) || optionalString(data.shop_logo, 1000)) &&
      (!('shop_banner' in data) || optionalString(data.shop_banner, 1000)) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('createdAt' in data) || data.createdAt is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp) &&
      (!('updatedAt' in data) || data.updatedAt is timestamp) &&
      (!('last_login_at' in data) || data.last_login_at is timestamp) &&
      (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
  }

  function isValidPrivateUserCreate(data) {
    return isValidPrivateUserBase(data) &&
      (
        requestRoleMatchesClaim(data) ||
        (claimRoleValue() == '' && data.role.lower() == 'customer')
      ) &&
      data.created_at is timestamp &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function isValidPrivateUserSelfUpdate(data, oldData) {
    return isValidPrivateUserBase(data) &&
      data.diff(oldData).affectedKeys().hasOnly([
        'email',
        'name',
        'displayName',
        'phone',
        'birth_date',
        'birthday',
        'avatar',
        'address',
        'note',
        'role',
        'auth_provider',
        'auth_providers',
        'last_auth_provider',
        'primary_auth_provider',
        'profile_sources',
        'last_login_at',
        'lastLoginAt',
        'updated_at',
        'updatedAt'
      ]) &&
      hasProfileName(data) &&
      data.email is string &&
      data.email.size() <= 180 &&
      optionalString(data.phone, 30) &&
      optionalDateString(data.birth_date) &&
      optionalDateString(data.birthday) &&
      optionalString(data.avatar, 1000) &&
      optionalString(data.address, 300) &&
      optionalString(data.note, 1000) &&
      optionalString(data.auth_provider, 60) &&
      (!('auth_providers' in data) || data.auth_providers is list) &&
      optionalString(data.last_auth_provider, 60) &&
      optionalString(data.primary_auth_provider, 60) &&
      (!('profile_sources' in data) || data.profile_sources is map) &&
      (!('last_login_at' in data) || data.last_login_at is timestamp) &&
      (!('lastLoginAt' in data) || data.lastLoginAt is timestamp) &&
      (
        requestRoleMatchesClaim(data) ||
        data.role == oldData.role
      ) &&
      (!('created_at' in oldData) || data.created_at == oldData.created_at) &&
      (!('createdAt' in oldData) || data.createdAt == oldData.createdAt) &&
      (!('disabled' in oldData) || data.disabled == oldData.disabled) &&
      (!('zalo_id' in oldData) || data.zalo_id == oldData.zalo_id) &&
      (!('seller_vendor_id' in oldData) || data.seller_vendor_id == oldData.seller_vendor_id) &&
      (!('shop_name' in oldData) || data.shop_name == oldData.shop_name) &&
      (!('shop_logo' in oldData) || data.shop_logo == oldData.shop_logo) &&
      (!('shop_banner' in oldData) || data.shop_banner == oldData.shop_banner) &&
      data.updated_at is timestamp;
  }

  function isValidPrivateUserAdminUpdate(data, oldData) {
    return isValidPrivateUserBase(data) &&
      data.diff(oldData).affectedKeys().hasOnly([
        'email',
        'name',
        'displayName',
        'phone',
        'birth_date',
        'birthday',
        'avatar',
        'role',
        'auth_provider',
        'auth_providers',
        'last_auth_provider',
        'primary_auth_provider',
        'profile_sources',
        'address',
        'note',
        'disabled',
        'seller_vendor_id',
        'shop_name',
        'shop_logo',
        'shop_banner',
        'updated_at',
        'updatedAt'
      ]) &&
      hasProfileName(data) &&
      data.email is string &&
      data.email.size() <= 180 &&
      optionalString(data.phone, 30) &&
      optionalDateString(data.birth_date) &&
      optionalDateString(data.birthday) &&
      optionalString(data.avatar, 1000) &&
      optionalString(data.auth_provider, 60) &&
      (!('auth_providers' in data) || data.auth_providers is list) &&
      optionalString(data.last_auth_provider, 60) &&
      optionalString(data.primary_auth_provider, 60) &&
      (!('profile_sources' in data) || data.profile_sources is map) &&
      optionalString(data.address, 300) &&
      optionalString(data.note, 1000) &&
      data.role is string &&
      data.role.lower() in ['customer', 'seller', 'carrier', 'moderator', 'manager', 'admin', 'owner'] &&
      (!('created_at' in oldData) || data.created_at == oldData.created_at) &&
      (!('createdAt' in oldData) || data.createdAt == oldData.createdAt) &&
      (!('last_login_at' in oldData) || data.last_login_at == oldData.last_login_at) &&
      (!('lastLoginAt' in oldData) || data.lastLoginAt == oldData.lastLoginAt) &&
      data.updated_at is timestamp;
  }

  function isValidUserDirectoryBase(data) {
    return data.keys().hasOnly([
        'name',
        'displayName',
        'avatar',
        'role',
        'isVerified',
        'disabled',
        'address',
        'note',
        'created_at',
        'createdAt',
        'updated_at',
        'updatedAt'
      ]) &&
      hasProfileName(data) &&
      optionalString(data.avatar, 1000) &&
      data.role is string &&
      data.role.lower() in ['customer', 'seller', 'carrier', 'moderator', 'manager', 'admin', 'owner'] &&
      (!('isVerified' in data) || data.isVerified is bool) &&
      (!('disabled' in data) || data.disabled is bool) &&
      optionalString(data.address, 300) &&
      optionalString(data.note, 1000) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('createdAt' in data) || data.createdAt is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp) &&
      (!('updatedAt' in data) || data.updatedAt is timestamp);
  }

  function isValidUserDirectoryCreate(db, userId, data) {
    return isValidUserDirectoryBase(data) &&
      data.role.lower() == privateUserRole(db, userId) &&
      data.updated_at is timestamp;
  }

  function isValidUserDirectorySelfUpdate(db, userId, data, oldData) {
    return isValidUserDirectoryBase(data) &&
      data.diff(oldData).affectedKeys().hasOnly([
        'name',
        'displayName',
        'avatar',
        'address',
        'note',
        'role',
        'isVerified',
        'updated_at',
        'updatedAt'
      ]) &&
      hasProfileName(data) &&
      optionalString(data.avatar, 1000) &&
      optionalString(data.address, 300) &&
      optionalString(data.note, 1000) &&
      data.role.lower() == privateUserRole(db, userId) &&
      (!('isVerified' in data) || data.isVerified is bool) &&
      data.updated_at is timestamp &&
      (!('created_at' in oldData) || data.created_at == oldData.created_at) &&
      (!('createdAt' in oldData) || data.createdAt == oldData.createdAt) &&
      (!('disabled' in oldData) || data.disabled == oldData.disabled);
  }

  function isValidUserDirectoryAdminUpdate(db, userId, data, oldData) {
    return isValidUserDirectoryBase(data) &&
      data.diff(oldData).affectedKeys().hasOnly([
        'name',
        'displayName',
        'avatar',
        'address',
        'note',
        'role',
        'isVerified',
        'disabled',
        'updated_at',
        'updatedAt'
      ]) &&
      hasProfileName(data) &&
      optionalString(data.avatar, 1000) &&
      optionalString(data.address, 300) &&
      optionalString(data.note, 1000) &&
      data.role.lower() == privateUserRole(db, userId) &&
      (!('isVerified' in data) || data.isVerified is bool) &&
      (!('disabled' in data) || data.disabled is bool) &&
      data.updated_at is timestamp &&
      (!('created_at' in oldData) || data.created_at == oldData.created_at) &&
      (!('createdAt' in oldData) || data.createdAt == oldData.createdAt);
  }

  // ─── Support tickets ─────────────────────────────────────────────────
  function isValidSupportTicketCreate(data) {
    return isAuth() &&
      data.userId == request.auth.uid &&
      data.subject is string &&
      data.subject.size() > 0 &&
      data.subject.size() <= 180 &&
      data.status == 'pending' &&
      data.category in ['general', 'order', 'payment', 'product', 'account', 'guide'] &&
      data.priority in ['low', 'medium', 'high'];
  }

  function isSupportTicketOwner(db, ticketId) {
    return isAuth() &&
      exists(/databases/$(db)/documents/supportTickets/$(ticketId)) &&
      get(/databases/$(db)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid;
  }

  function isValidSupportMessageCreate(db, ticketId) {
    return isAuth() &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 4000 &&
      (
        (
          isSupportTicketOwner(db, ticketId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRole == 'user'
        ) ||
        (
          isSupportTicketOwner(db, ticketId) &&
          request.resource.data.senderId == 'aivy-bot' &&
          request.resource.data.senderRole == 'aivy' &&
          request.resource.data.isAutoReply == true &&
          request.resource.data.generatedBy == request.auth.uid &&
          optionalString(request.resource.data.senderName, 80)
        ) ||
        (
          isModerator(db) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderRole == 'admin'
        )
      );
  }

  // ─── Audit logs (append-only) ────────────────────────────────────────
  function isValidAuditLogCreate() {
    return isAuth() &&
      request.resource.data.keys().hasOnly([
        'action',
        'actor_id',
        'actor_email',
        'actor_role',
        'target_type',
        'target_id',
        'details',
        'ip_address',
        'user_agent',
        'created_at'
      ]) &&
      request.resource.data.keys().hasAll([
        'action',
        'actor_id',
        'actor_role',
        'target_type',
        'target_id',
        'details',
        'created_at'
      ]) &&
      request.resource.data.actor_id == request.auth.uid &&
      request.resource.data.action in [
        'vendor_register',
        'vendor_approve',
        'vendor_reject',
        'vendor_suspend',
        'vendor_kyc_start',
        'vendor_kyc_submit',
        'vendor_kyc_status_change',
        'product_create',
        'product_update',
        'product_delete',
        'product_submit',
        'product_approve',
        'product_reject',
        'order_status_change',
        'document_upload',
        'login',
        'logout',
        'role_change',
        'report_submit',
        'report_resolve',
        'review_submit',
        'review_approve',
        'review_reject',
        'settings_change',
        'voucher_create',
        'voucher_update',
        'voucher_delete',
        'support_reply',
        'support_status_update'
      ] &&
      request.resource.data.actor_role is string &&
      request.resource.data.actor_role.size() <= 60 &&
      optionalString(request.resource.data.actor_email, 180) &&
      request.resource.data.target_type is string &&
      request.resource.data.target_type.size() > 0 &&
      request.resource.data.target_type.size() <= 80 &&
      request.resource.data.target_id is string &&
      request.resource.data.target_id.size() > 0 &&
      request.resource.data.target_id.size() <= 180 &&
      request.resource.data.details is map &&
      optionalString(request.resource.data.ip_address, 80) &&
      optionalString(request.resource.data.user_agent, 500) &&
      request.resource.data.created_at is timestamp;
  }

  // ─── Notifications ───────────────────────────────────────────────────
  function isNotificationOwnerReadUpdate() {
    return isAuth() &&
      resource.data.user_id == request.auth.uid &&
      request.resource.data.user_id == resource.data.user_id &&
      changedOnly(['read', 'read_at']) &&
      request.resource.data.read is bool;
  }

  // ─── Payment methods ─────────────────────────────────────────────────
  function isPaymentMethodOwnerCreate() {
    return isAuth() &&
      request.resource.data.userId == request.auth.uid;
  }

  function isPaymentMethodOwnerUpdate() {
    return isAuth() &&
      resource.data.userId == request.auth.uid &&
      request.resource.data.userId == resource.data.userId;
  }

  // ─── Shop profiles (display-only mirror) ─────────────────────────────
  function isValidShopDisplayConfig(config) {
    return config is map &&
      config.keys().hasOnly([
        'layout',
        'moduleOrder',
        'enabledModules',
        'pinnedProductIds'
      ]) &&
      config.layout in ['grid', 'carousel'] &&
      config.moduleOrder is list &&
      config.moduleOrder.size() <= 20 &&
      config.enabledModules is list &&
      config.enabledModules.size() <= 20 &&
      config.pinnedProductIds is list &&
      config.pinnedProductIds.size() <= 12;
  }

  function isValidShopProfile(data, shopId) {
    return data.keys().hasOnly([
        'shopId',
        'vendorId',
        'shopName',
        'shopSlug',
        'logoUrl',
        'bannerUrl',
        'displayConfig',
        'affiliateCommissionBps',
        'updatedAt',
        'createdAt'
      ]) &&
      data.shopId == shopId &&
      data.vendorId is string &&
      data.vendorId.size() > 0 &&
      data.vendorId.size() <= 180 &&
      data.shopName is string &&
      data.shopName.size() > 0 &&
      data.shopName.size() <= 160 &&
      data.shopSlug is string &&
      data.shopSlug.size() <= 180 &&
      optionalString(data.logoUrl, 1000) &&
      optionalString(data.bannerUrl, 1000) &&
      isValidShopDisplayConfig(data.displayConfig) &&
      data.affiliateCommissionBps is number &&
      data.affiliateCommissionBps >= 0 &&
      data.affiliateCommissionBps <= 10000;
  }

  // ─── Product reviews ─────────────────────────────────────────────────
  function isProductReviewerUpdate() {
    return isAuth() &&
      resource.data.userId == request.auth.uid &&
      request.resource.data.userId == resource.data.userId &&
      request.resource.data.shopId == resource.data.shopId &&
      request.resource.data.productId == resource.data.productId &&
      request.resource.data.status == resource.data.status &&
      changedOnly([
        'visibility',
        'comment',
        'photos',
        'tags',
        'anonymous',
        'updatedAt'
      ]) &&
      request.resource.data.visibility in ['public', 'private'] &&
      optionalString(request.resource.data.comment, 2000) &&
      request.resource.data.photos is list &&
      request.resource.data.photos.size() <= 6 &&
      request.resource.data.tags is list &&
      request.resource.data.tags.size() <= 20 &&
      request.resource.data.anonymous is bool;
  }

  function isProductReviewModeratorUpdate(db) {
    return isModerator(db) &&
      request.resource.data.userId == resource.data.userId &&
      request.resource.data.shopId == resource.data.shopId &&
      request.resource.data.productId == resource.data.productId &&
      changedOnly([
        'status',
        'approvedAt',
        'approvedBy',
        'rejectedReason',
        'updatedAt'
      ]) &&
      request.resource.data.status in ['pending', 'approved', 'rejected'] &&
      optionalString(request.resource.data.rejectedReason, 1000);
  }

  // ─── Products (seller content updates) ───────────────────────────────
  function isSellerProductUpdate() {
    return isAuth() &&
      resource.data.shopId == request.auth.uid &&
      request.resource.data.shopId == resource.data.shopId &&
      request.resource.data.status in ['draft', 'pending', 'archived'] &&
      unchangedAll([
        'vendorId',
        'totalSold',
        'rating',
        'reviewCount',
        'views',
        'approvedAt',
        'approvedBy',
        'acfVerified',
        'created_at'
      ]) &&
      changedOnly([
        'shopName',
        'shopSlug',
        'title',
        'handle',
        'description',
        'brand',
        'category',
        'thumbnail',
        'images',
        'basePrice',
        'variants',
        'promotion',
        'totalStock',
        'weightGrams',
        'dimensions',
        'warehouses',
        'status',
        'rejectedReason',
        'submittedAt',
        'acfVerifyStatus',
        'metaDescription',
        'metadata',
        'updated_at'
      ]) &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.title.size() <= 200 &&
      request.resource.data.basePrice is number &&
      request.resource.data.basePrice > 0 &&
      request.resource.data.images is list &&
      request.resource.data.images.size() > 0 &&
      request.resource.data.images.size() <= 12 &&
      request.resource.data.variants is list &&
      request.resource.data.variants.size() <= 20 &&
      isValidProductPromotion(request.resource.data.promotion) &&
      request.resource.data.totalStock is number &&
      request.resource.data.totalStock >= 0 &&
      (!('weightGrams' in request.resource.data) ||
        request.resource.data.weightGrams == null ||
        (request.resource.data.weightGrams is number &&
          request.resource.data.weightGrams >= 0)) &&
      isValidProductDimensions(request.resource.data.dimensions) &&
      isValidProductWarehouses(request.resource.data.warehouses) &&
      (!('submittedAt' in request.resource.data) ||
        request.resource.data.submittedAt == null ||
        request.resource.data.submittedAt is timestamp);
  }

  function isSellerDraftProductDelete() {
    return isAuth() &&
      resource.data.shopId == request.auth.uid &&
      resource.data.status == 'draft';
  }

  function isValidOptionalWarehouseCoordinate(data, field, minValue, maxValue) {
    return !(field in data) ||
      data[field] == null ||
      (data[field] is number && data[field] >= minValue && data[field] <= maxValue);
  }

  function isValidProductWarehouse(data) {
    return data is map &&
      data.keys().hasOnly([
        'id',
        'warehouseName',
        'contactName',
        'contactPhone',
        'fullAddress',
        'ward',
        'district',
        'city',
        'latitude',
        'longitude',
        'note',
        'isDefault'
      ]) &&
      nonEmptyString(data.id, 120) &&
      nonEmptyString(data.warehouseName, 120) &&
      nonEmptyString(data.contactName, 120) &&
      data.contactPhone is string &&
      data.contactPhone.matches('^[0-9+()\\-\\s]{8,20}$') &&
      nonEmptyString(data.fullAddress, 240) &&
      nonEmptyString(data.ward, 120) &&
      nonEmptyString(data.district, 120) &&
      nonEmptyString(data.city, 120) &&
      isValidOptionalWarehouseCoordinate(data, 'latitude', -90, 90) &&
      isValidOptionalWarehouseCoordinate(data, 'longitude', -180, 180) &&
      optionalString(data.note, 500) &&
      data.isDefault is bool;
  }

  function isValidProductWarehouses(list) {
    return list is list &&
      list.size() > 0 &&
      list.size() <= 10 &&
      isValidProductWarehouse(list[0]) &&
      (list.size() < 2 || isValidProductWarehouse(list[1])) &&
      (list.size() < 3 || isValidProductWarehouse(list[2])) &&
      (list.size() < 4 || isValidProductWarehouse(list[3])) &&
      (list.size() < 5 || isValidProductWarehouse(list[4])) &&
      (list.size() < 6 || isValidProductWarehouse(list[5])) &&
      (list.size() < 7 || isValidProductWarehouse(list[6])) &&
      (list.size() < 8 || isValidProductWarehouse(list[7])) &&
      (list.size() < 9 || isValidProductWarehouse(list[8])) &&
      (list.size() < 10 || isValidProductWarehouse(list[9]));
  }

  function isValidProductPromotion(data) {
    return data is map &&
      data.keys().hasOnly([
        'voucherScope',
        'voucherIds',
        'voucherCodes',
        'affiliateCommissionBps'
      ]) &&
      data.voucherScope in ['none', 'product', 'category'] &&
      data.voucherIds is list &&
      data.voucherIds.size() <= 20 &&
      data.voucherCodes is list &&
      data.voucherCodes.size() <= 20 &&
      (
        !('affiliateCommissionBps' in data) ||
        data.affiliateCommissionBps == null ||
        (data.affiliateCommissionBps is number &&
          data.affiliateCommissionBps >= 0 &&
          data.affiliateCommissionBps <= 10000)
      );
  }

  function isValidProductDimensions(data) {
    return data == null ||
      (data is map &&
        data.keys().hasOnly(['length', 'width', 'height']) &&
        data.length is number &&
        data.length > 0 &&
        data.width is number &&
        data.width > 0 &&
        data.height is number &&
        data.height > 0);
  }

  function isValidSellerProductCreate(data) {
    return isAuth() &&
      data.keys().hasOnly([
        'shopId',
        'vendorId',
        'shopName',
        'shopSlug',
        'title',
        'handle',
        'description',
        'brand',
        'category',
        'thumbnail',
        'images',
        'basePrice',
        'variants',
        'promotion',
        'totalStock',
        'weightGrams',
        'dimensions',
        'warehouses',
        'status',
        'rejectedReason',
        'submittedAt',
        'approvedAt',
        'approvedBy',
        'acfVerified',
        'acfVerifyStatus',
        'metaDescription',
        'totalSold',
        'rating',
        'reviewCount',
        'views',
        'metadata',
        'created_at',
        'updated_at'
      ]) &&
      incomingOwnsField('shopId') &&
      data.shopId is string &&
      data.vendorId is string &&
      data.shopName is string &&
      data.shopSlug is string &&
      nonEmptyString(data.title, 200) &&
      nonEmptyString(data.handle, 120) &&
      optionalString(data.description, 5000) &&
      nonEmptyString(data.brand, 120) &&
      nonEmptyString(data.category, 120) &&
      nonEmptyString(data.thumbnail, 1000) &&
      data.images is list &&
      data.images.size() > 0 &&
      data.images.size() <= 12 &&
      data.basePrice is number &&
      data.basePrice > 0 &&
      data.variants is list &&
      data.variants.size() <= 20 &&
      isValidProductPromotion(data.promotion) &&
      data.totalStock is number &&
      data.totalStock >= 0 &&
      (!('weightGrams' in data) || data.weightGrams == null || (data.weightGrams is number && data.weightGrams >= 0)) &&
      isValidProductDimensions(data.dimensions) &&
      isValidProductWarehouses(data.warehouses) &&
      data.status in ['draft', 'pending'] &&
      data.rejectedReason == null &&
      (
        data.submittedAt == null ||
        data.submittedAt is timestamp
      ) &&
      data.approvedAt == null &&
      data.approvedBy == null &&
      data.acfVerified is bool &&
      data.acfVerifyStatus in ['none', 'requested', 'approved', 'rejected'] &&
      optionalString(data.metaDescription, 4000) &&
      data.totalSold is number &&
      data.totalSold >= 0 &&
      data.rating is number &&
      data.rating >= 0 &&
      data.reviewCount is number &&
      data.reviewCount >= 0 &&
      data.views is number &&
      data.views >= 0 &&
      (!('metadata' in data) || data.metadata == null || data.metadata is map) &&
      data.created_at is timestamp &&
      data.updated_at is timestamp;
  }

  // ─── User-path ownership helpers ─────────────────────────────────────
  function isUserOwner(userId) {
    return isAuth() && request.auth.uid == userId;
  }

  function isExistingUserOwner(db, userId) {
    return isUserOwner(userId) &&
      exists(/databases/$(db)/documents/users/$(userId));
  }

  // ─── Generic predicates (used by validators below) ───────────────────
  function nonEmptyString(value, maxSize) {
    return value is string &&
      value.size() > 0 &&
      value.size() <= maxSize;
  }

  function optionalString(value, maxSize) {
    return value == null ||
      (value is string && value.size() <= maxSize);
  }

  function optionalDateString(value) {
    return value == null ||
      (value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$'));
  }

  // ─── Privacy settings ────────────────────────────────────────────────
  function isValidPrivacySettings(data, userId) {
    return data.keys().hasOnly([
        'user_id',
        'public_reviews',
        'aivy_personalization',
        'analytics_cookies',
        'marketing_cookies',
        'marketing_messages',
        'profiling_opt_out',
        'cross_border_sharing',
        'policy_version',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'user_id',
        'public_reviews',
        'aivy_personalization',
        'analytics_cookies',
        'marketing_cookies',
        'marketing_messages',
        'profiling_opt_out',
        'cross_border_sharing',
        'policy_version',
        'updated_at'
      ]) &&
      data.user_id == userId &&
      data.public_reviews is bool &&
      data.aivy_personalization is bool &&
      data.analytics_cookies is bool &&
      data.marketing_cookies is bool &&
      data.marketing_messages is bool &&
      data.profiling_opt_out is bool &&
      data.cross_border_sharing is bool &&
      nonEmptyString(data.policy_version, 40) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      data.updated_at is timestamp;
  }

  // ─── Aivy assistant history ──────────────────────────────────────────
  function isValidAivyHistoryMessage(message) {
    return message is map &&
      message.keys().hasOnly([
        'id',
        'role',
        'content',
        'timestamp'
      ]) &&
      nonEmptyString(message.id, 120) &&
      message.role in ['user', 'assistant'] &&
      nonEmptyString(message.content, 4000) &&
      message.timestamp is number &&
      message.timestamp > 0;
  }

  function isValidAivyHistoryMessages(messages) {
    return messages is list &&
      messages.size() <= 10 &&
      (messages.size() < 1 || isValidAivyHistoryMessage(messages[0])) &&
      (messages.size() < 2 || isValidAivyHistoryMessage(messages[1])) &&
      (messages.size() < 3 || isValidAivyHistoryMessage(messages[2])) &&
      (messages.size() < 4 || isValidAivyHistoryMessage(messages[3])) &&
      (messages.size() < 5 || isValidAivyHistoryMessage(messages[4])) &&
      (messages.size() < 6 || isValidAivyHistoryMessage(messages[5])) &&
      (messages.size() < 7 || isValidAivyHistoryMessage(messages[6])) &&
      (messages.size() < 8 || isValidAivyHistoryMessage(messages[7])) &&
      (messages.size() < 9 || isValidAivyHistoryMessage(messages[8])) &&
      (messages.size() < 10 || isValidAivyHistoryMessage(messages[9]));
  }

  function isValidAivyHistory(data, userId) {
    return data.keys().hasOnly([
        'user_id',
        'messages',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'user_id',
        'messages',
        'updated_at'
      ]) &&
      data.user_id == userId &&
      isValidAivyHistoryMessages(data.messages) &&
      data.updated_at is timestamp;
  }

  // ─── Data subject rights (GDPR / NDPR) ───────────────────────────────
  function isValidDataRightsRequest(data, userId) {
    return data.keys().hasOnly([
        'user_id',
        'type',
        'status',
        'description',
        'contact_email',
        'policy_version',
        'source',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'user_id',
        'type',
        'status',
        'description',
        'contact_email',
        'policy_version',
        'source',
        'created_at',
        'updated_at'
      ]) &&
      data.user_id == userId &&
      data.type in [
        'access',
        'rectification',
        'erasure',
        'portability',
        'restriction',
        'objection',
        'withdraw_consent'
      ] &&
      data.status == 'pending' &&
      optionalString(data.description, 2000) &&
      optionalString(data.contact_email, 180) &&
      nonEmptyString(data.policy_version, 40) &&
      data.source == 'account_privacy_settings' &&
      data.created_at is timestamp &&
      data.updated_at is timestamp;
  }

  function isValidDataRightsRequestAdminUpdate(data, oldData, userId) {
    return data.keys().hasOnly([
        'user_id',
        'type',
        'status',
        'description',
        'contact_email',
        'policy_version',
        'source',
        'admin_note',
        'created_at',
        'updated_at',
        'processed_at'
      ]) &&
      data.keys().hasAll([
        'user_id',
        'type',
        'status',
        'description',
        'contact_email',
        'policy_version',
        'source',
        'created_at',
        'updated_at'
      ]) &&
      data.diff(oldData).affectedKeys().hasOnly([
        'status',
        'admin_note',
        'updated_at',
        'processed_at'
      ]) &&
      data.user_id == userId &&
      data.user_id == oldData.user_id &&
      data.type == oldData.type &&
      data.description == oldData.description &&
      data.contact_email == oldData.contact_email &&
      data.policy_version == oldData.policy_version &&
      data.source == oldData.source &&
      data.created_at == oldData.created_at &&
      data.status in ['pending', 'reviewing', 'completed', 'rejected', 'cancelled'] &&
      optionalString(data.admin_note, 2000) &&
      data.updated_at is timestamp &&
      (!('processed_at' in data) ||
        data.processed_at == null ||
        data.processed_at is timestamp);
  }

  function nonNegativeNumber(value) {
    return value is number && value >= 0;
  }

  // ─── User addresses ──────────────────────────────────────────────────
  function isValidUserAddress(data) {
    return data.keys().hasOnly([
        'label',
        'name',
        'phone',
        'address',
        'ward',
        'district',
        'city',
        'isDefault',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'label',
        'name',
        'phone',
        'address',
        'ward',
        'district',
        'city',
        'isDefault'
      ]) &&
      data.label in ['home', 'office', 'other'] &&
      nonEmptyString(data.name, 120) &&
      data.phone is string &&
      data.phone.matches('^[0-9+()\\-\\s]{8,20}$') &&
      nonEmptyString(data.address, 240) &&
      optionalString(data.ward, 120) &&
      optionalString(data.district, 120) &&
      optionalString(data.city, 120) &&
      data.isDefault is bool &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  // ─── Loyalty (points + redeem ledger) ────────────────────────────────
  function isValidLoyaltyState(data, userId) {
    return data.keys().hasOnly([
        'customer_id',
        'balance',
        'total_earned',
        'total_redeemed',
        'total_expired',
        'lifetime_spend',
        'tier',
        'tier_anniversary',
        'last_transaction_id',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'customer_id',
        'balance',
        'total_earned',
        'total_redeemed',
        'total_expired',
        'lifetime_spend',
        'tier'
      ]) &&
      data.customer_id == userId &&
      nonNegativeNumber(data.balance) &&
      nonNegativeNumber(data.total_earned) &&
      nonNegativeNumber(data.total_redeemed) &&
      nonNegativeNumber(data.total_expired) &&
      nonNegativeNumber(data.lifetime_spend) &&
      data.tier in ['silver', 'gold', 'platinum', 'diamond'] &&
      optionalString(data.last_transaction_id, 180) &&
      (!('tier_anniversary' in data) ||
        data.tier_anniversary == null ||
        data.tier_anniversary is timestamp) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function isOwnerLoyaltyRedeemState(db, userId) {
    return isUserOwner(userId) &&
      isValidLoyaltyState(request.resource.data, userId) &&
      isValidLoyaltyState(resource.data, userId) &&
      request.resource.data.balance <= resource.data.balance &&
      request.resource.data.total_redeemed >= resource.data.total_redeemed &&
      request.resource.data.total_earned == resource.data.total_earned &&
      request.resource.data.total_expired == resource.data.total_expired &&
      request.resource.data.lifetime_spend == resource.data.lifetime_spend &&
      request.resource.data.tier == resource.data.tier &&
      hasMatchingLoyaltyRedeemTransactionAfter(db, userId);
  }

  function hasMatchingLoyaltyRedeemTransactionAfter(db, userId) {
    return request.resource.data.last_transaction_id is string &&
      existsAfter(/databases/$(db)/documents/users/$(userId)/loyaltyTransactions/$(request.resource.data.last_transaction_id)) &&
      getAfter(/databases/$(db)/documents/users/$(userId)/loyaltyTransactions/$(request.resource.data.last_transaction_id)).data.type == 'redeem' &&
      getAfter(/databases/$(db)/documents/users/$(userId)/loyaltyTransactions/$(request.resource.data.last_transaction_id)).data.points ==
        request.resource.data.balance - resource.data.balance;
  }

  function isValidLoyaltyRedeemTransaction(data) {
    return data.keys().hasOnly([
        'type',
        'points',
        'description',
        'reference_type',
        'reference_id',
        'voucher_code',
        'voucher_value',
        'expires_at',
        'expired_at',
        'idempotency_key',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'type',
        'points',
        'description',
        'reference_type',
        'reference_id',
        'created_at'
      ]) &&
      data.type == 'redeem' &&
      data.points is number &&
      data.points < 0 &&
      data.points >= -1000000 &&
      nonEmptyString(data.description, 240) &&
      data.reference_type in ['voucher', 'freeship', 'cashback'] &&
      nonEmptyString(data.reference_id, 120) &&
      optionalString(data.voucher_code, 80) &&
      (!('voucher_value' in data) || data.voucher_value == null || nonNegativeNumber(data.voucher_value)) &&
      (!('expires_at' in data) || data.expires_at == null || data.expires_at is timestamp) &&
      (!('expired_at' in data) || data.expired_at == null || data.expired_at is timestamp) &&
      optionalString(data.idempotency_key, 180) &&
      data.created_at is timestamp &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function hasLoyaltyRedeemStateAfter(db, userId) {
    return exists(/databases/$(db)/documents/users/$(userId)/loyaltyState/current) &&
      getAfter(/databases/$(db)/documents/users/$(userId)/loyaltyState/current).data.balance ==
        get(/databases/$(db)/documents/users/$(userId)/loyaltyState/current).data.balance +
        request.resource.data.points &&
      getAfter(/databases/$(db)/documents/users/$(userId)/loyaltyState/current).data.total_redeemed ==
        get(/databases/$(db)/documents/users/$(userId)/loyaltyState/current).data.total_redeemed -
        request.resource.data.points;
  }

  // ─── Wallet (balance + topup/withdraw ledger) ────────────────────────
  function isValidWalletState(data, userId) {
    return data.keys().hasOnly([
        'customer_id',
        'balance',
        'locked_balance',
        'total_claimed',
        'total_withdrawn',
        'last_transaction_id',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'customer_id',
        'balance',
        'locked_balance',
        'total_claimed',
        'total_withdrawn'
      ]) &&
      data.customer_id == userId &&
      nonNegativeNumber(data.balance) &&
      nonNegativeNumber(data.locked_balance) &&
      nonNegativeNumber(data.total_claimed) &&
      nonNegativeNumber(data.total_withdrawn) &&
      optionalString(data.last_transaction_id, 180) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function isOwnerWalletInitialState(userId) {
    return isUserOwner(userId) &&
      isValidWalletState(request.resource.data, userId) &&
      request.resource.data.balance == 0 &&
      request.resource.data.locked_balance == 0 &&
      request.resource.data.total_claimed == 0 &&
      request.resource.data.total_withdrawn == 0;
  }

  function isOwnerWalletWithdrawState(db, userId) {
    return isUserOwner(userId) &&
      isValidWalletState(request.resource.data, userId) &&
      isValidWalletState(resource.data, userId) &&
      request.resource.data.balance <= resource.data.balance &&
      request.resource.data.locked_balance >= resource.data.locked_balance &&
      request.resource.data.balance + request.resource.data.locked_balance ==
        resource.data.balance + resource.data.locked_balance &&
      request.resource.data.total_claimed == resource.data.total_claimed &&
      request.resource.data.total_withdrawn >= resource.data.total_withdrawn &&
      hasMatchingWalletWithdrawTransactionAfter(db, userId);
  }

  function hasMatchingWalletWithdrawTransactionAfter(db, userId) {
    return request.resource.data.last_transaction_id is string &&
      existsAfter(/databases/$(db)/documents/users/$(userId)/walletTransactions/$(request.resource.data.last_transaction_id)) &&
      getAfter(/databases/$(db)/documents/users/$(userId)/walletTransactions/$(request.resource.data.last_transaction_id)).data.type == 'withdraw' &&
      getAfter(/databases/$(db)/documents/users/$(userId)/walletTransactions/$(request.resource.data.last_transaction_id)).data.amount ==
        request.resource.data.balance - resource.data.balance;
  }

  function isValidOwnerWalletTransaction(data) {
    return data.keys().hasOnly([
        'type',
        'amount',
        'balance',
        'description',
        'status',
        'method',
        'reference_type',
        'reference_id',
        'idempotency_key',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'type',
        'amount',
        'balance',
        'description',
        'status',
        'method',
        'created_at'
      ]) &&
      nonNegativeNumber(data.balance) &&
      nonEmptyString(data.description, 240) &&
      data.status == 'pending' &&
      data.created_at is timestamp &&
      optionalString(data.reference_type, 80) &&
      optionalString(data.reference_id, 180) &&
      optionalString(data.idempotency_key, 180) &&
      (!('updated_at' in data) || data.updated_at is timestamp) &&
      (
        (data.type == 'topup' &&
          data.amount is number &&
          data.amount >= 10000 &&
          data.amount <= 50000000 &&
          data.method in ['momo', 'zalopay', 'vnpay', 'bank']) ||
        (data.type == 'withdraw' &&
          data.amount is number &&
          data.amount <= -10000 &&
          data.amount >= -50000000 &&
          data.method in ['bank', 'momo', 'zalopay'])
      );
  }

  function isOwnerWalletTopupTransaction(data) {
    return data.type == 'topup' &&
      data.amount is number &&
      data.amount >= 10000;
  }

  function hasWalletTopupStateSnapshot(db, userId) {
    return (
      exists(/databases/$(db)/documents/users/$(userId)/walletState/current) &&
      request.resource.data.balance ==
        get(/databases/$(db)/documents/users/$(userId)/walletState/current).data.balance
    ) || (
      !exists(/databases/$(db)/documents/users/$(userId)/walletState/current) &&
      request.resource.data.balance == 0
    );
  }

  function isOwnerWalletWithdrawTransaction(data) {
    return data.type == 'withdraw' &&
      data.amount is number &&
      data.amount <= -10000;
  }

  function hasWalletWithdrawStateAfter(db, userId) {
    return exists(/databases/$(db)/documents/users/$(userId)/walletState/current) &&
      getAfter(/databases/$(db)/documents/users/$(userId)/walletState/current).data.balance ==
        get(/databases/$(db)/documents/users/$(userId)/walletState/current).data.balance +
        request.resource.data.amount &&
      getAfter(/databases/$(db)/documents/users/$(userId)/walletState/current).data.locked_balance ==
        get(/databases/$(db)/documents/users/$(userId)/walletState/current).data.locked_balance -
        request.resource.data.amount &&
      getAfter(/databases/$(db)/documents/users/$(userId)/walletState/current).data.total_withdrawn ==
        get(/databases/$(db)/documents/users/$(userId)/walletState/current).data.total_withdrawn -
        request.resource.data.amount;
  }


  // ─── Affiliate program ───────────────────────────────────────────────
  function isValidAffiliateProfile(data, userId) {
    return data.keys().hasOnly([
        'customer_id',
        'display_name',
        'status',
        'tier',
        'default_commission_bps',
        'total_clicks',
        'total_conversions',
        'lifetime_commission',
        'pending_commission',
        'paid_commission',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'customer_id',
        'status',
        'tier',
        'default_commission_bps'
      ]) &&
      data.customer_id == userId &&
      optionalString(data.display_name, 120) &&
      data.status in ['pending', 'active', 'suspended'] &&
      data.tier in ['bronze', 'silver', 'gold', 'platinum', 'diamond'] &&
      data.default_commission_bps is number &&
      data.default_commission_bps >= 0 &&
      data.default_commission_bps <= 10000 &&
      (!('total_clicks' in data) || nonNegativeNumber(data.total_clicks)) &&
      (!('total_conversions' in data) || nonNegativeNumber(data.total_conversions)) &&
      (!('lifetime_commission' in data) || nonNegativeNumber(data.lifetime_commission)) &&
      (!('pending_commission' in data) || nonNegativeNumber(data.pending_commission)) &&
      (!('paid_commission' in data) || nonNegativeNumber(data.paid_commission)) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function isValidAffiliateLink(data, userId) {
    return data.keys().hasOnly([
        'affiliate_id',
        'customer_id',
        'short_code',
        'title',
        'target_url',
        'target_type',
        'target_id',
        'shop_id',
        'shop_name',
        'plan_id',
        'product_image',
        'product_price',
        'commission_bps',
        'showcase_order',
        'showcase_visible',
        'status',
        'clicks',
        'unique_clicks',
        'conversions',
        'total_commission',
        'last_click_at',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'affiliate_id',
        'customer_id',
        'short_code',
        'target_url',
        'target_type',
        'status',
        'clicks',
        'unique_clicks',
        'conversions',
        'total_commission',
        'created_at'
      ]) &&
      data.affiliate_id == userId &&
      data.customer_id == userId &&
      nonEmptyString(data.short_code, 80) &&
      optionalString(data.title, 180) &&
      data.target_url is string &&
      data.target_url.size() <= 1000 &&
      (data.target_url.matches('^https://.*') || data.target_url.matches('^http://.*')) &&
      data.target_type in ['product', 'shop', 'category', 'campaign', 'home'] &&
      optionalString(data.target_id, 180) &&
      (!('product_image' in data) ||
        data.product_image == null ||
        (data.product_image is string && data.product_image.size() <= 1000)) &&
      (!('product_price' in data) ||
        data.product_price == null ||
        (data.product_price is number && data.product_price >= 0)) &&
      (data.commission_bps == null ||
        (data.commission_bps is number &&
          data.commission_bps >= 0 &&
          data.commission_bps <= 10000)) &&
      (!('showcase_order' in data) ||
        data.showcase_order == null ||
        (data.showcase_order is number && data.showcase_order >= 0)) &&
      (!('showcase_visible' in data) || data.showcase_visible is bool) &&
      data.status in ['active', 'paused', 'pending', 'expired'] &&
      data.clicks == 0 &&
      data.unique_clicks == 0 &&
      data.conversions == 0 &&
      data.total_commission == 0 &&
      (data.last_click_at == null || data.last_click_at is timestamp) &&
      data.created_at is timestamp &&
      (!('updated_at' in data) || data.updated_at is timestamp);
  }

  function isAffiliateLinkOwner(db, linkId) {
    return isAuth() &&
      exists(/databases/$(db)/documents/affiliateLinks/$(linkId)) &&
      (
        get(/databases/$(db)/documents/affiliateLinks/$(linkId)).data.affiliate_id == request.auth.uid ||
        get(/databases/$(db)/documents/affiliateLinks/$(linkId)).data.affiliateId == request.auth.uid
      );
  }

  function isValidAffiliateLinkOwnerUpdate(data, oldData) {
    return data.keys().hasOnly([
        'affiliate_id',
        'customer_id',
        'short_code',
        'title',
        'target_url',
        'target_type',
        'target_id',
        'shop_id',
        'shop_name',
        'plan_id',
        'product_image',
        'product_price',
        'commission_bps',
        'showcase_order',
        'showcase_visible',
        'status',
        'clicks',
        'unique_clicks',
        'conversions',
        'total_commission',
        'last_click_at',
        'created_at',
        'updated_at'
      ]) &&
      (
        ('affiliate_id' in oldData && oldData.affiliate_id == request.auth.uid) ||
        ('affiliateId' in oldData && oldData.affiliateId == request.auth.uid)
      ) &&
      data.affiliate_id == oldData.affiliate_id &&
      data.customer_id == oldData.customer_id &&
      data.short_code == oldData.short_code &&
      data.clicks == oldData.clicks &&
      data.unique_clicks == oldData.unique_clicks &&
      data.conversions == oldData.conversions &&
      data.total_commission == oldData.total_commission &&
      data.created_at == oldData.created_at &&
      optionalString(data.title, 180) &&
      data.target_url is string &&
      data.target_url.size() <= 1000 &&
      (data.target_url.matches('^https://.*') || data.target_url.matches('^http://.*')) &&
      data.target_type in ['product', 'shop', 'category', 'campaign', 'home'] &&
      optionalString(data.target_id, 180) &&
      optionalString(data.shop_id, 180) &&
      optionalString(data.shop_name, 180) &&
      optionalString(data.plan_id, 180) &&
      (!('product_image' in data) ||
        data.product_image == null ||
        (data.product_image is string && data.product_image.size() <= 1000)) &&
      (!('product_price' in data) ||
        data.product_price == null ||
        (data.product_price is number && data.product_price >= 0)) &&
      (data.commission_bps == null ||
        (data.commission_bps is number &&
          data.commission_bps >= 0 &&
          data.commission_bps <= 10000)) &&
      (!('showcase_order' in data) ||
        data.showcase_order == null ||
        (data.showcase_order is number && data.showcase_order >= 0)) &&
      (!('showcase_visible' in data) || data.showcase_visible is bool) &&
      data.status in ['active', 'paused', 'pending', 'expired'] &&
      (data.last_click_at == null || data.last_click_at is timestamp) &&
      data.updated_at is timestamp;
  }

  // ─── Returns / refunds ───────────────────────────────────────────────
  function isValidReturnRequestCreate(db, data) {
    return data.keys().hasOnly([
        'orderId',
        'orderCode',
        'customerId',
        'customerEmail',
        'shopId',
        'shopName',
        'items',
        'reason',
        'reasonLabel',
        'refundMethod',
        'refundAmount',
        'description',
        'photos',
        'status',
        'created_at',
        'updated_at'
      ]) &&
      data.keys().hasAll([
        'orderId',
        'orderCode',
        'customerId',
        'shopId',
        'items',
        'reason',
        'reasonLabel',
        'refundMethod',
        'refundAmount',
        'photos',
        'status',
        'created_at',
        'updated_at'
      ]) &&
      data.orderId is string &&
      data.orderCode is string &&
      data.customerId == request.auth.uid &&
      optionalString(data.customerEmail, 180) &&
      data.shopId is string &&
      optionalString(data.shopName, 180) &&
      data.items is list &&
      data.items.size() > 0 &&
      data.items.size() <= 100 &&
      nonEmptyString(data.reason, 80) &&
      nonEmptyString(data.reasonLabel, 180) &&
      data.refundMethod in ['wallet', 'bank', 'exchange'] &&
      nonNegativeNumber(data.refundAmount) &&
      data.refundAmount > 0 &&
      data.refundAmount <= 100000000 &&
      optionalString(data.description, 4000) &&
      data.photos is list &&
      data.photos.size() <= 6 &&
      data.status == 'pending' &&
      data.created_at is timestamp &&
      data.updated_at is timestamp &&
      exists(/databases/$(db)/documents/orders/$(data.orderId)) &&
      get(/databases/$(db)/documents/orders/$(data.orderId)).data.customerId == request.auth.uid &&
      get(/databases/$(db)/documents/orders/$(data.orderId)).data.shopId == data.shopId &&
      get(/databases/$(db)/documents/orders/$(data.orderId)).data.total >= data.refundAmount &&
      get(/databases/$(db)/documents/orders/$(data.orderId)).data.status in ['shipping', 'delivered', 'completed'];
  }

  // ─── Voucher validators ──────────────────────────────────────────────
  function isValidVoucherCreate() {
    return isAuth() &&
      incomingOwnsField('shopId') &&
      request.resource.data.code is string &&
      request.resource.data.code.size() > 0 &&
      request.resource.data.code.size() <= 32 &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.title.size() <= 200 &&
      request.resource.data.discountType in ['percent', 'fixed', 'shipping'] &&
      request.resource.data.value is number &&
      request.resource.data.value > 0 &&
      request.resource.data.minOrderValue is number &&
      request.resource.data.minOrderValue >= 0 &&
      request.resource.data.usageLimit is number &&
      request.resource.data.usageLimit >= 0 &&
      request.resource.data.usedCount == 0 &&
      request.resource.data.isActive is bool;
  }

  function isSellerVoucherUpdate() {
    return isAuth() &&
      ownsField('shopId') &&
      keepsField('shopId') &&
      keepsField('code') &&
      keepsField('usedCount') &&
      keepsField('createdAt');
  }

  // ─── Live stream validators ──────────────────────────────────────────
  // Stream metadata is server-controlled for Cloudflare-issued fields;
  // viewer counters allow incremental +/-1 only and peakViewers is
  // monotonic. Aggregations beyond +/-1 must go through Cloud Functions.

  function isValidStreamCreate() {
    return isAuth() &&
      incomingOwnsField('vendor_id') &&
      request.resource.data.status == 'scheduled' &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.title.size() <= 200 &&
      !request.resource.data.keys().hasAny([
        'cloudflare_playback_uid',
        'cloudflare_provisioned_at',
        'verified_origin',
        'actual_start_at',
        'ended_at',
        'hls_url'
      ]);
  }

  function isStreamOwnerMetadataUpdate() {
    return ownsField('vendor_id') &&
      changedOnly([
        'title',
        'description',
        'thumbnail_url',
        'category',
        'scheduled_start_at',
        'firestore_room_id',
        'updated_at'
      ]);
  }

  function isStreamViewerCounterUpdate() {
    return isAuth() &&
      changedOnly(['viewerCount', 'peakViewers']) &&
      request.resource.data.viewerCount is number &&
      request.resource.data.viewerCount >= 0 &&
      request.resource.data.peakViewers is number &&
      request.resource.data.peakViewers >= 0 &&
      request.resource.data.peakViewers >= request.resource.data.viewerCount &&
      request.resource.data.viewerCount >= resource.data.viewerCount - 1 &&
      request.resource.data.viewerCount <= resource.data.viewerCount + 1 &&
      request.resource.data.peakViewers >= resource.data.peakViewers;
  }

  function isStreamOwner(db, streamId) {
    return isAuth() &&
      exists(/databases/$(db)/documents/streams/$(streamId)) &&
      get(/databases/$(db)/documents/streams/$(streamId)).data.vendor_id == request.auth.uid;
  }

  function isValidStreamChatCreate() {
    return isAuth() &&
      incomingOwnsField('senderId') &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 500 &&
      (!('senderName' in request.resource.data) ||
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() <= 120);
  }

  // ─── Counterfeit / chat report validators ────────────────────────────
  function isValidCounterfeitReportCreate() {
    return isAuth() &&
      incomingOwnsField('reporterId') &&
      request.resource.data.productId is string &&
      request.resource.data.productId.size() > 0 &&
      request.resource.data.productId.size() <= 180 &&
      request.resource.data.description is string &&
      request.resource.data.description.size() > 0 &&
      request.resource.data.description.size() <= 4000 &&
      (!('status' in request.resource.data) ||
        request.resource.data.status == 'pending');
  }

  function isValidChatReportCreate() {
    return isAuth() &&
      incomingOwnsField('reporterId') &&
      request.resource.data.conversationId is string &&
      request.resource.data.conversationId.size() > 0 &&
      request.resource.data.reportedUserId is string &&
      request.resource.data.reportedUserId.size() > 0 &&
      request.resource.data.reason is string &&
      request.resource.data.reason.size() > 0 &&
      request.resource.data.reason.size() <= 2000 &&
      request.resource.data.status == 'pending';
  }

  function isValidSellerApplicationCreate() {
    return isAuth() &&
      incomingOwnsField('userId') &&
      (!('status' in request.resource.data) ||
        request.resource.data.status == 'pending');
  }

  function isValidCategoryRequestCreate() {
    return isAuth() &&
      incomingOwnsField('shopId') &&
      request.resource.data.requestedName is string &&
      request.resource.data.requestedName.size() >= 3 &&
      request.resource.data.requestedName.size() <= 120 &&
      request.resource.data.status == 'pending';
  }

  // ─── Support ticket validators ───────────────────────────────────────
  function isSupportTicketOwnerUpdate() {
    return isAuth() &&
      ownsField('userId') &&
      keepsField('userId') &&
      keepsField('status') &&
      changedOnly([
        'lastMessage',
        'lastMessageAt',
        'unreadCountForAdmin',
        'updatedAt',
        'aivySummary'
      ]);
  }

  // ─── Order update validators ─────────────────────────────────────────
  // Order status transitions are tightly bound by role. Each helper
  // captures one transition path so the main rule reads as a list of
  // allowed transitions instead of nested OR conditions.

  function isShopOrderUpdate() {
    return isAuth() &&
      ownsField('shopId') &&
      keepsField('shopId') &&
      changedOnly(['status', 'updated_at', 'timeline', 'trackingNumber']);
  }

  function isCarrierOrderUpdate() {
    return isAuth() &&
      ownsField('carrierId') &&
      changedOnly(['status', 'updated_at', 'timeline', 'trackingNumber']);
  }

  function isCustomerOrderCancelUpdate() {
    return isAuth() &&
      ownsField('customerId') &&
      resource.data.status in ['payment_pending', 'awaiting_confirm'] &&
      request.resource.data.status == 'cancelled' &&
      changedOnly(['status', 'updated_at', 'timeline']);
  }

  function isCustomerOrderReturnUpdate() {
    return isAuth() &&
      ownsField('customerId') &&
      resource.data.status in ['shipping', 'delivered', 'completed'] &&
      request.resource.data.status == 'return_requested' &&
      changedOnly(['status', 'updated_at', 'timeline', 'returnRequestId']);
  }

  // ─── Conversation update validator ───────────────────────────────────
  function isConversationParticipantUpdate() {
    return isAuth() &&
      isParticipant('participants') &&
      changedOnly([
        'lastMessage',
        'lastMessageAt',
        'unreadCount',
        'typing',
        'lastReadAt',
        'blockedBy'
      ]);
  }

  // ─── Early payout request validator ──────────────────────────────────
  function isValidEarlyPayoutRequestCreate() {
    return isAuth() &&
      incomingOwnsField('shopId') &&
      incomingOwnsField('requestedBy') &&
      request.resource.data.status == 'pending';
  }

  // ─── VAT invoice validator ───────────────────────────────────────────
  function isValidVatInvoiceCreate() {
    return isAuth() &&
      incomingOwnsField('shopId') &&
      request.resource.data.invoiceNumber is string &&
      request.resource.data.invoiceNumber.size() > 0 &&
      request.resource.data.invoiceNumber.size() <= 120 &&
      request.resource.data.total is number &&
      request.resource.data.total >= 0 &&
      request.resource.data.total <= 100000000;
  }

  // ════════════════════════════════════════════════════════════════════
  // SECTION 4 · COLLECTION RULES
  // ════════════════════════════════════════════════════════════════════
  // Organised by domain. Each domain block uses the helpers and
  // validators defined above; rule blocks should remain thin policy
  // surfaces, not contain inline business logic.
  //
  //   ┌─ Identity ──────────────────────────────────────────────────────┐
  //   │ publicProfiles, publicShopProfiles, users (+ subcols)           │
  //   ├─ Commerce ──────────────────────────────────────────────────────┤
  //   │ products, categoryRequests, orders, returnRequests,             │
  //   │ refundTransactions, carts                                       │
  //   ├─ Seller ────────────────────────────────────────────────────────┤
  //   │ vendors, sellerApplications, sellerBalances, sellerPayouts,     │
  //   │ sellerTransactions, earlyPayoutRequests, vouchers, vatInvoices, │
  //   │ shopProfiles                                                    │
  //   ├─ Moderation & Audit ────────────────────────────────────────────┤
  //   │ auditLogs, counterfeitReports, productVerifications,            │
  //   │ chatReports, notifications                                      │
  //   ├─ Community ─────────────────────────────────────────────────────┤
  //   │ socialPosts (+ comments)                                        │
  //   ├─ Chat & Support ────────────────────────────────────────────────┤
  //   │ conversations (+ messages), supportTickets (+ messages)         │
  //   ├─ Affiliate & Payments ──────────────────────────────────────────┤
  //   │ affiliateLinks, affiliateReferrals, escrowPayments,             │
  //   │ paymentMethods                                                  │
  //   ├─ Live commerce ─────────────────────────────────────────────────┤
  //   │ streams (+ chat, viewers, pinned_products), streamCredentials   │
  //   ├─ Storefront content ────────────────────────────────────────────┤
  //   │ banners, productReviews                                         │
  //   └─ System ────────────────────────────────────────────────────────┘
  //     systemSettings, globalSettings, default-deny catch-all
  match /databases/{database}/documents {

    // ─── Public profile mirrors (no PII) ───────────────────────────────
    // publicProfiles and publicShopProfiles are world-readable storefront
    // mirrors. Schema is enforced on every write so PII (email/phone/
    // address) and moderation flags cannot leak via the public read path.
    match /publicProfiles/{userId} {
      allow read: if publicRead();
      allow create: if isAuth() &&
        isValidPublicProfile(request.resource.data) &&
        (
          isModerator(database) ||
          (
            request.auth.uid == userId &&
            request.resource.data.role in ['customer', 'seller', 'carrier', 'moderator', 'admin', 'owner'] &&
            request.resource.data.hasApprovedShop == false &&
            request.resource.data.shopId == null
          )
        );
      allow update: if isAuth() &&
        isValidPublicProfile(request.resource.data) &&
        (
          isModerator(database) ||
          (
            request.auth.uid == userId &&
            request.resource.data.role in ['customer', 'seller', 'carrier', 'moderator', 'admin', 'owner'] &&
            keepsField('hasApprovedShop') &&
            keepsField('shopId')
          )
        );
      allow delete: if isAdmin(database);

      match /affiliateShowcaseLinks/{linkId} {
        allow read: if publicRead();
        allow create, update, delete: if isAuth() &&
          (
            request.auth.uid == userId ||
            isModerator(database)
          ) &&
          isValidPublicAffiliateShowcaseLink(request.resource.data);
      }
    }

    match /publicShopProfiles/{shopId} {
      allow get, list: if resource.data.status == 'active' || isModerator(database);
      allow create: if isAuth() &&
        isValidPublicShopProfile(request.resource.data) &&
        (
          isModerator(database) ||
          (
            incomingOwnsField('ownerUid') &&
            request.resource.data.status == 'pending'
          )
        );
      allow update: if isAuth() &&
        isValidPublicShopProfile(request.resource.data) &&
        (
          isModerator(database) ||
          (
            ownsField('ownerUid') &&
            keepsField('ownerUid') &&
            keepsField('status') &&
            keepsField('kycLevel') &&
            keepsField('verifiedAt')
          )
        );
      allow delete: if isAdmin(database);
    }

    // ─── User directory (manager-safe mirror) ───────────────────────────
    match /userDirectory/{userId} {
      allow get, list: if isAuth() && (isAdmin(database) || isManager(database));

      allow create: if isAuth() && (
        (
          request.auth.uid == userId &&
          isValidUserDirectoryCreate(database, userId, request.resource.data)
        ) ||
        (
          isAdmin(database) &&
          isValidUserDirectoryCreate(database, userId, request.resource.data)
        )
      );
      allow update: if isAuth() && (
        (
          request.auth.uid == userId &&
          isValidUserDirectorySelfUpdate(
            database,
            userId,
            request.resource.data,
            resource.data
          )
        ) ||
        (
          isAdmin(database) &&
          isValidUserDirectoryAdminUpdate(
            database,
            userId,
            request.resource.data,
            resource.data
          )
        )
      );
      allow delete: if isAdmin(database);
    }

    // ─── User profiles ──────────────────────────────────────────────────
    match /users/{userId} {
      // Private profile docs contain PII. Only the owner and admin/owner
      // can read them; manager must use the sanitized /userDirectory mirror.
      allow get: if isAuth() && (request.auth.uid == userId || isAdmin(database));
      allow list: if isAdmin(database);

      allow create: if isAuth() &&
        request.auth.uid == userId &&
        isValidPrivateUserCreate(request.resource.data);
      allow update: if isAuth() && (
        (
          request.auth.uid == userId &&
          isValidPrivateUserSelfUpdate(request.resource.data, resource.data)
        ) ||
        (
          isOwner(database) &&
          isValidPrivateUserAdminUpdate(request.resource.data, resource.data)
        ) ||
        (
          isAdminUserUpdate(database) &&
          isValidPrivateUserAdminUpdate(request.resource.data, resource.data)
        )
      );
      allow delete: if isOwner(database) ||
        (isAdmin(database) && roleValue(resource.data) != 'owner');

      match /addresses/{addressId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isUserOwner(userId) &&
          isValidUserAddress(request.resource.data);
        allow update: if isUserOwner(userId) &&
          isValidUserAddress(request.resource.data);
        allow delete: if isUserOwner(userId) || isAdmin(database);
      }

      match /privacySettings/{settingId} {
        allow get, list: if isExistingUserOwner(database, userId) || isAdmin(database);
        allow create, update: if settingId == 'current' &&
          isExistingUserOwner(database, userId) &&
          isValidPrivacySettings(request.resource.data, userId);
        allow delete: if isAdmin(database);
      }

      match /aivyHistory/{historyId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create, update: if historyId == 'current' &&
          isUserOwner(userId) &&
          isValidAivyHistory(request.resource.data, userId);
        allow delete: if isUserOwner(userId) || isAdmin(database);
      }

      match /verificationCabinet/{itemId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isUserOwner(userId);
        allow delete: if isUserOwner(userId) || isAdmin(database);
      }

      match /dataRightsRequests/{requestId} {
        allow get, list: if isExistingUserOwner(database, userId) || isAdmin(database);
        allow create: if isExistingUserOwner(database, userId) &&
          isValidDataRightsRequest(request.resource.data, userId);
        allow update: if isAdmin(database) &&
          isValidDataRightsRequestAdminUpdate(
            request.resource.data,
            resource.data,
            userId
          );
        allow delete: if isAdmin(database);
      }

      match /loyaltyState/{stateId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isAdmin(database) ||
          (stateId == 'current' &&
            isUserOwner(userId) &&
            isValidLoyaltyState(request.resource.data, userId) &&
            request.resource.data.balance == 0 &&
            request.resource.data.total_earned == 0 &&
            request.resource.data.total_redeemed == 0 &&
            request.resource.data.total_expired == 0 &&
            request.resource.data.lifetime_spend == 0);
        allow update: if isAdmin(database) ||
          (stateId == 'current' && isOwnerLoyaltyRedeemState(database, userId));
        allow delete: if isAdmin(database);
      }

      match /loyaltyTransactions/{transactionId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isAdmin(database) ||
          (isUserOwner(userId) &&
            isValidLoyaltyRedeemTransaction(request.resource.data) &&
            hasLoyaltyRedeemStateAfter(database, userId));
        allow update, delete: if isAdmin(database);
      }

      match /walletState/{stateId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isAdmin(database) ||
          (stateId == 'current' && isOwnerWalletInitialState(userId));
        allow update: if isAdmin(database) ||
          (stateId == 'current' && isOwnerWalletWithdrawState(database, userId));
        allow delete: if isAdmin(database);
      }

      match /walletTransactions/{transactionId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isAdmin(database) ||
          (isUserOwner(userId) &&
            isValidOwnerWalletTransaction(request.resource.data) &&
            (
              (isOwnerWalletTopupTransaction(request.resource.data) &&
                hasWalletTopupStateSnapshot(database, userId)) ||
              (isOwnerWalletWithdrawTransaction(request.resource.data) &&
                hasWalletWithdrawStateAfter(database, userId))
            ));
        allow update, delete: if isAdmin(database);
      }

      match /walletClaims/{claimId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create, update, delete: if isAdmin(database);
      }

      match /affiliateProfile/{profileId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create: if isAdmin(database) ||
          (profileId == 'current' &&
            isUserOwner(userId) &&
            isValidAffiliateProfile(request.resource.data, userId) &&
            request.resource.data.default_commission_bps == 500 &&
            request.resource.data.total_clicks == 0 &&
            request.resource.data.total_conversions == 0 &&
            request.resource.data.lifetime_commission == 0 &&
            request.resource.data.pending_commission == 0 &&
            request.resource.data.paid_commission == 0);
        allow update, delete: if isAdmin(database);
      }

      match /affiliateTransactions/{transactionId} {
        allow get, list: if isUserOwner(userId) || isAdmin(database);
        allow create, update, delete: if isAdmin(database);
      }
    }

    match /userProfiles/{userId} {
      allow read, create, update, delete: if isUserOwner(userId);
    }

    // ─── Products ───────────────────────────────────────────────────────
    match /products/{productId} {
      // Buyers can browse approved products only. Seller can read own working
      // catalog; moderators can read the moderation queue.
      allow get, list: if resource.data.status == 'approved' ||
        (isAuth() && (isModerator(database) || ownsField('shopId')));

      // Sellers can create products for their own shop.
      // Initial status must be "draft" or "pending" (seller cannot self-approve).
      allow create: if isValidSellerProductCreate(request.resource.data);

      // Update rules:
      // - Admin/moderator can change anything (approve/reject)
      // - Owner edits content via isSellerProductUpdate (whitelisted keys
      //   only, immutable moderation/audit fields, status capped at
      //   draft/pending/archived so seller cannot self-approve).
      allow update: if isModerator(database) || isSellerProductUpdate();
      allow delete: if isAdmin(database) || isSellerDraftProductDelete();
    }

    // ─── Product category requests ──────────────────────────────────────
    match /categoryRequests/{requestId} {
      allow get, list: if isModerator(database) || ownsField('shopId');
      allow create: if isValidCategoryRequestCreate();
      allow update, delete: if isModerator(database);
    }

    // ─── Orders ─────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customer, seller, carrier, moderator/admin can read.
      // Moderator/admin can list all orders for the admin dashboard.
      allow get, list: if isAuth() && (
        isModerator(database) ||
        ownsField('customerId') ||
        ownsField('shopId') ||
        ownsField('carrierId')
      );

      // Authenticated buyers can create only initial order states. Payment
      // confirmation and fulfillment transitions come from backend/admin
      // or the assigned seller/carrier.
      allow create: if isAuth() && isValidInitialOrder();

      // Order status transitions are partitioned by role: shop, carrier,
      // customer-cancel, customer-return, admin-anything.
      allow update: if isAdmin(database) ||
        isShopOrderUpdate() ||
        isCarrierOrderUpdate() ||
        isCustomerOrderCancelUpdate() ||
        isCustomerOrderReturnUpdate();

      allow delete: if isAdmin(database);
    }

    // ─── Return / refund requests ───────────────────────────────────────
    match /returnRequests/{requestId} {
      allow get, list: if isAuth() && (
        isModerator(database) ||
        ownsField('customerId') ||
        ownsField('shopId')
      );
      allow create: if isAuth() &&
        isValidReturnRequestCreate(database, request.resource.data);
      allow update, delete: if isModerator(database);
    }

    match /refundTransactions/{refundId} {
      allow get, list: if isAuth() &&
        (isModerator(database) || ownsField('customerId'));
      allow create, update, delete: if isModerator(database);
    }

    // ─── Carts ──────────────────────────────────────────────────────────
    match /carts/{userId} {
      allow read, write: if isUserOwner(userId);
    }
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isUserOwner(userId);
    }

    // ─── Vendors (seller registration) ──────────────────────────────────
    match /vendors/{vendorId} {
      // Owner can read their own; moderators/admin can read & list all
      allow get, list: if isAuth() &&
        (isModerator(database) || ownsField('firebase_uid'));

      // Any authenticated user can register as vendor (must use own UID)
      allow create: if isAuth() &&
        incomingOwnsField('firebase_uid') &&
        request.resource.data.status == 'pending';

      // Moderator/admin can update status; owner can update own profile when active
      allow update: if isAuth() &&
        (isModerator(database) || isVendorOwnerProfileUpdate());

      allow delete: if isAdmin(database);
    }

    // ─── Seller eKYC applications ─────────────────────────────────────
    match /kycApplications/{applicationId} {
      // Owner can read their own KYC history; moderators/admin can read all.
      allow read: if isAuth() &&
        (isModerator(database) || ownsField('firebase_uid'));
      // KYC writes are handled by Cloud Functions using Admin SDK.
      allow create, update, delete: if false;
    }

    // ─── Audit logs (append-only) ───────────────────────────────────────
    match /auditLogs/{logId} {
      allow read, list: if isModerator(database);
      allow create: if isValidAuditLogCreate();
      allow update, delete: if false;
    }

    // ─── Notifications ──────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if ownsField('user_id');
      allow update: if isNotificationOwnerReadUpdate() || isModerator(database);
      allow create: if isModerator(database);
      allow delete: if ownsField('user_id');
    }

    // ─── Counterfeit reports ────────────────────────────────────────────
    match /counterfeitReports/{reportId} {
      allow get: if isAuth() && (isModerator(database) || ownsField('reporterId'));
      allow list: if isModerator(database);
      allow create: if isValidCounterfeitReportCreate();
      allow update: if isModerator(database);
      allow delete: if isAdmin(database);
    }

    // ─── Shop profiles (display config) ─────────────────────────────────
    // Public read — schema enforced via isValidShopProfile, which limits
    // keys to display-only fields (no contact info / kyc / financials).
    match /shopProfiles/{shopId} {
      allow read: if publicRead();
      allow create: if isAuth() &&
        request.auth.uid == shopId &&
        isValidShopProfile(request.resource.data, shopId);
      allow update: if isAuth() && (
        isAdmin(database) ||
        (
          request.auth.uid == shopId &&
          keepsField('shopId') &&
          keepsField('createdAt') &&
          isValidShopProfile(request.resource.data, shopId)
        )
      );
      allow delete: if isAdmin(database);
    }

    // ─── Product verifications ──────────────────────────────────────────
    match /productVerifications/{verificationId} {
      allow read: if isAuth();
      allow create: if isModerator(database);
      allow update: if isModerator(database);
      allow delete: if isAdmin(database);
    }

    // ─── Payment methods ────────────────────────────────────────────────
    match /paymentMethods/{documentId} {
      allow read: if isAuth() && (resource == null || ownsField('userId'));
      allow create: if isPaymentMethodOwnerCreate();
      allow update: if isPaymentMethodOwnerUpdate();
      allow delete: if ownsField('userId');
    }

    // ─── Product reviews ────────────────────────────────────────────────
    // Visibility model:
    //   - public + approved → world-readable (product page, public profile)
    //   - private → only reviewer, shop owner of reviewed item, or admin
    //   - pending/rejected (any visibility) → reviewer + shop + admin
    match /productReviews/{reviewId} {
      allow read: if
        (resource.data.visibility == 'public' && resource.data.status == 'approved') ||
        (isAuth() && (ownsField('userId') || ownsField('shopId') || isModerator(database)));
      // Reviewer creates their own review with a valid rating + visibility.
      allow create: if isAuth() &&
        incomingOwnsField('userId') &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.visibility in ['public', 'private'] &&
        request.resource.data.status == 'pending';
      // Reviewer can change only public-facing content/privacy fields.
      // Moderator can change only moderation fields.
      allow update: if isProductReviewerUpdate() ||
        isProductReviewModeratorUpdate(database);
      allow delete: if isAuth() && (ownsField('userId') || isAdmin(database));
    }

    // ─── Community news feed ───────────────────────────────────────────
    match /socialPosts/{postId} {
      allow read: if publicRead();
      allow create: if isValidSocialPostCreate();
      allow update: if isModerator(database) ||
        isSocialPostAuthorUpdate() ||
        isSocialPostLikeUpdate() ||
        isSocialPostShareUpdate() ||
        isSocialPostCommentCounterUpdate();
      allow delete: if isAuth() && (ownsField('authorId') || isModerator(database));

      match /comments/{commentId} {
        allow read: if publicRead();
        allow create: if isValidSocialCommentCreate(postId);
        allow update: if isModerator(database) || isSocialCommentAuthorUpdate();
        allow delete: if isAuth() && (ownsField('authorId') || isModerator(database));
      }
    }

    // ─── Affiliate referrals ────────────────────────────────────────────
    // Owner/admin can read all of their links; anyone can read active
    // links so public profile pages can showcase them.
    match /affiliateLinks/{linkId} {
      allow get, list: if (
        isAuth() && (
          isAdmin(database) ||
          ownsField('affiliate_id') ||
          ownsField('affiliateId')
        )
      ) ||
      (
        resource.data.status == 'active' &&
        (
          !('showcase_visible' in resource.data) ||
          resource.data.showcase_visible == true
        )
      );
      allow create: if isAuth() &&
        isValidAffiliateLink(request.resource.data, request.auth.uid);
      // Admin: full update/delete
      allow update: if isAdmin(database);
      allow delete: if isAdmin(database) || isAffiliateLinkOwner(database, linkId);
      allow update: if isAuth() &&
        isValidAffiliateLinkOwnerUpdate(request.resource.data, resource.data) &&
        isAffiliateLinkOwner(database, linkId);
      // Public click tracking: only increment clicks + update last_click_at
      allow update: if
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'unique_clicks', 'last_click_at']) &&
        request.resource.data.clicks == resource.data.clicks + 1 &&
        request.resource.data.last_click_at is timestamp;
    }

    match /affiliateReferrals/{referralId} {
      allow read: if isAuth() && (isAdmin(database) || ownsField('affiliateId'));
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Affiliate Plans (TikTok-style) ─────────────────────────────────
    match /affiliatePlans/{planId} {
      // Active open plans are public-readable; others only by shop owner or admin
      allow get: if isAuth();
      allow list: if isAuth();
      // Shop owner creates plans for their own shop
      allow create: if isAuth() &&
        request.resource.data.shopId == request.auth.uid &&
        request.resource.data.commissionBps is number &&
        request.resource.data.commissionBps >= 0 &&
        request.resource.data.commissionBps <= 5000 &&
        request.resource.data.title is string &&
        request.resource.data.type in ['open', 'targeted'];
      // Shop owner updates own plan
      allow update: if isAuth() && resource.data.shopId == request.auth.uid;
      // Shop owner or admin deletes
      allow delete: if isAuth() && (resource.data.shopId == request.auth.uid || isAdmin(database));
    }

    // ─── Affiliate Applications ─────────────────────────────────────────
    match /affiliateApplications/{applicationId} {
      // Readable by the shop owner or the creator who applied
      allow get, list: if isAuth() && (
        isAdmin(database) ||
        ownsField('shopId') ||
        ownsField('creatorId')
      );
      // Creator applies (cannot apply to own shop)
      allow create: if isAuth() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.creatorId != request.resource.data.shopId &&
        request.resource.data.planId is string;
      // Shop owner can approve/reject; only status + reviewedAt + reviewedBy fields
      allow update: if isAuth() && resource.data.shopId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy']);
      allow delete: if isAdmin(database);
    }

    // ─── Escrow payments ────────────────────────────────────────────────
    match /escrowPayments/{paymentId} {
      allow read: if isAuth() && (
        isAdmin(database) ||
        ownsField('buyerId') ||
        ownsField('sellerId')
      );
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller applications (legacy) ───────────────────────────────────
    match /sellerApplications/{applicationId} {
      allow read: if isAuth() && (isModerator(database) || ownsField('userId'));
      allow create: if isValidSellerApplicationCreate();
      allow update, delete: if isModerator(database);
    }

    // ─── Conversations / Chat ───────────────────────────────────────────
    match /conversations/{convoId} {
      allow get: if resource == null || isParticipant('participants');
      allow list: if isParticipant('participants');
      allow create: if isValidConversationCreate();
      allow update: if isConversationParticipantUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(database, convoId);
        allow create: if isValidMessageCreate(database, convoId);
        allow update, delete: if false;
      }
    }

    match /chatReports/{reportId} {
      allow get, list: if isModerator(database) ||
        (isAuth() && ownsField('reporterId'));
      allow create: if isValidChatReportCreate();
      allow update, delete: if isModerator(database);
    }

    match /supportTickets/{ticketId} {
      allow get, list: if isModerator(database) ||
        (isAuth() && ownsField('userId'));
      allow create: if isValidSupportTicketCreate(request.resource.data);
      allow update: if isModerator(database) || isSupportTicketOwnerUpdate();
      allow delete: if isAdmin(database);

      match /messages/{messageId} {
        allow read: if isModerator(database) || isSupportTicketOwner(database, ticketId);
        allow create: if isValidSupportMessageCreate(database, ticketId);
        allow update, delete: if false;
      }
    }

    // ─── User follows ─────────────────────────────────────────────────
    match /userFollows/{followId} {
      allow read: if isAuth();
      allow create: if isAuth() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followeeId is string &&
        request.resource.data.followerId != request.resource.data.followeeId;
      allow delete: if isAuth() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ─── Banners (homepage slider) ──────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if publicRead();
      allow create, update, delete: if isModerator(database);
    }

    // ─── Portal UI configuration (images per portal dashboard) ─────────
    match /portalConfig/{portal} {
      allow read: if publicRead();
      allow create, update: if isAdmin(database);
      allow delete: if isOwner(database);
    }

    // ─── System settings ────────────────────────────────────────────────
    match /systemSettings/{settingsId} {
      allow read: if isModerator(database);
      allow create, update: if isAdmin(database);
      allow delete: if isOwner(database);
    }

    match /globalSettings/{settingsId} {
      allow read: if isAuth();
      allow create, update: if isAdmin(database);
      allow delete: if isOwner(database);
    }

    // ─── Seller finance: balance snapshot (1 doc / shop) ────────────────
    match /sellerBalances/{shopId} {
      allow read: if isAuth() && (isAdmin(database) || request.auth.uid == shopId);
      // Only admin/backend may write balance — sellers cannot self-credit.
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller finance: payouts ────────────────────────────────────────
    match /sellerPayouts/{payoutId} {
      allow get, list: if isAuth() && (isAdmin(database) || ownsField('shopId'));
      // Payouts are created/updated by backend escrow worker (admin role).
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller finance: transactions (ledger) ──────────────────────────
    match /sellerTransactions/{txId} {
      allow get, list: if isAuth() && (isAdmin(database) || ownsField('shopId'));
      // Ledger is append-only and written by backend.
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller early-payout requests ───────────────────────────────────
    match /earlyPayoutRequests/{requestId} {
      allow get, list: if isAuth() && (isAdmin(database) || ownsField('shopId'));
      allow create: if isValidEarlyPayoutRequestCreate();
      allow update, delete: if isAdmin(database);
    }

    // ─── Vouchers (seller-issued discount codes) ────────────────────────
    // Sellers create/update/delete vouchers for their own shop.
    // Buyers read only active vouchers. usedCount is admin-only (backend
    // increments it when an order consumes the voucher).
    match /vouchers/{voucherId} {
      allow get, list: if resource.data.isActive == true ||
        (isAuth() && (isModerator(database) || ownsField('shopId')));
      allow create: if isValidVoucherCreate();
      // Seller cannot change shopId/code/usedCount/createdAt.
      // Admin can update anything (including usedCount when redeeming).
      allow update: if isAdmin(database) || isSellerVoucherUpdate();
      allow delete: if isAuth() && (isAdmin(database) || ownsField('shopId'));
    }

    // ─── VAT invoices (seller-issued) ───────────────────────────────────
    match /vatInvoices/{invoiceId} {
      allow get, list: if isAuth() && (isAdmin(database) || ownsField('shopId'));
      // Sellers may issue invoices for their own shop. Series/invoiceNumber/
      // totals are sanitized client-side; signed e-invoice IDs come later
      // when integrating with VN tax authority (TCT) e-invoice provider.
      allow create: if isValidVatInvoiceCreate();
      // Issued invoices are immutable. Only admin can cancel.
      allow update, delete: if isAdmin(database);
    }

    // ─── Live streams (Cloudflare Stream Live integration) ──────────────
    // Public read of stream meta so the buyer storefront can render
    // `/live` and `/live/:id` for everyone (including anonymous viewers).
    // Sensitive RTMPS credentials are written by Cloud Functions to a
    // separate `streamCredentials/{id}` collection that denies all client
    // access; the public `streams/{id}` doc keeps only `cloudflare_playback_uid`
    // which is useless without the RS256 signing private key.
    //
    // viewerCount/peakViewers are bumped client-side by joinStream/
    // leaveStream but bounded to +/-1 per write so a single client cannot
    // forge arbitrary numbers. Authoritative aggregation belongs in a
    // Cloud Function reading the /viewers/{uid} subcollection.
    match /streams/{streamId} {
      allow read: if publicRead();
      allow create: if isValidStreamCreate();
      allow update: if isAdmin(database) ||
        isStreamOwnerMetadataUpdate() ||
        isStreamViewerCounterUpdate();
      allow delete: if isAdmin(database);

      match /chat/{msgId} {
        allow read: if publicRead();
        allow create: if isValidStreamChatCreate();
        allow update: if false;
        allow delete: if isAdmin(database) || (isAuth() && ownsField('senderId'));
      }

      match /viewers/{userId} {
        allow read: if isAuth() && (
          request.auth.uid == userId ||
          isAdmin(database) ||
          isStreamOwner(database, streamId)
        );
        allow write: if isUserOwner(userId);
      }

      match /pinned_products/{productId} {
        allow read: if publicRead();
        allow write: if isStreamOwner(database, streamId);
      }
    }

    // ─── Live stream credentials (RTMPS URL + stream key) ───────────────
    // Owner-only data, never readable from the client. All access goes
    // through the `getStreamCredentials` callable Cloud Function which
    // uses the admin SDK (rules bypassed) and enforces ownership in code.
    match /streamCredentials/{streamId} {
      allow read, write: if false;
    }

    // ─── Default deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
