rules_version = '2';
service cloud.firestore {

  // ─── Role helpers ─────────────────────────────────────────────────────
  // Roles can come from EITHER:
  //   1) Custom claims set via Firebase Admin SDK (fast, no extra read)
  //   2) /users/{uid}.role document field (fallback for users provisioned
  //      via Firestore directly without Cloud Function side-effects)
  // We prefer custom claim; if absent we read the user doc. Document reads
  // billed against the rules quota are cached per request.

  function authedUid() {
    return request.auth.uid;
  }

  function claimRole() {
    return request.auth.token.role;
  }

  function docRole(db) {
    return get(/databases/$(db)/documents/users/$(authedUid())).data.role;
  }

  function hasClaim(role) {
    return request.auth != null && claimRole() == role;
  }

  function hasDocRole(db, role) {
    return request.auth != null &&
      exists(/databases/$(db)/documents/users/$(authedUid())) &&
      docRole(db) == role;
  }

  function isAdmin(db) {
    return hasClaim('owner') || hasClaim('admin') ||
      hasDocRole(db, 'owner') || hasDocRole(db, 'admin');
  }

  function isOwner(db) {
    return hasClaim('owner') || hasDocRole(db, 'owner');
  }

  function isModerator(db) {
    return hasClaim('owner') || hasClaim('admin') || hasClaim('moderator') ||
      hasDocRole(db, 'owner') || hasDocRole(db, 'admin') || hasDocRole(db, 'moderator');
  }

  function isOwnerProfileUpdate(userId) {
    return request.auth.uid == userId &&
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'disabled'
      ]);
  }

  function isAdminUserUpdate(db) {
    return isAdmin(db) &&
      resource.data.role != 'owner' &&
      request.resource.data.role != 'owner';
  }

  function changedOnly(fields) {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
  }

  function isVendorOwnerProfileUpdate() {
    return resource.data.firebase_uid == request.auth.uid &&
      resource.data.status == 'active' &&
      request.resource.data.firebase_uid == resource.data.firebase_uid &&
      request.resource.data.status == resource.data.status &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'shop_name',
        'shop_slug',
        'shop_logo',
        'shop_banner',
        'description',
        'owner_name',
        'owner_email',
        'owner_phone',
        'pickup_address',
        'bank_name',
        'bank_account_number',
        'bank_account_holder',
        'updated_at'
      ]);
  }

  function isValidInitialOrder() {
    return request.resource.data.keys().hasAll([
        'code',
        'customerId',
        'shopId',
        'status',
        'paymentStatus',
        'items',
        'total'
      ]) &&
      request.resource.data.code is string &&
      request.resource.data.customerId == request.auth.uid &&
      request.resource.data.shopId is string &&
      request.resource.data.items is list &&
      request.resource.data.items.size() > 0 &&
      request.resource.data.items.size() <= 100 &&
      request.resource.data.total is number &&
      request.resource.data.total >= 0 &&
      (
        (request.resource.data.paymentStatus == 'pending' &&
          request.resource.data.status == 'payment_pending') ||
        (request.resource.data.paymentStatus in ['cod', 'paid'] &&
          request.resource.data.status == 'awaiting_confirm')
      );
  }

  function isAuth() {
    return request.auth != null;
  }

  function isValidSocialPostCreate() {
    return isAuth() &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.type in ['status', 'question', 'product_share'] &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 5000 &&
      request.resource.data.authorName is string &&
      request.resource.data.likeCount == 0 &&
      request.resource.data.commentCount == 0 &&
      request.resource.data.shareCount == 0 &&
      request.resource.data.likedBy is list &&
      request.resource.data.likedBy.size() == 0 &&
      (
        (request.resource.data.type == 'product_share' &&
          isValidSocialProductSnapshot()) ||
        (request.resource.data.type != 'product_share' &&
          request.resource.data.product == null)
      );
  }

  function isValidSocialProductSnapshot() {
    return request.resource.data.product is map &&
      request.resource.data.product.keys().hasOnly([
        'id',
        'handle',
        'title',
        'image',
        'price',
        'shopName'
      ]) &&
      request.resource.data.product.id is string &&
      request.resource.data.product.id.size() > 0 &&
      request.resource.data.product.handle is string &&
      request.resource.data.product.handle.size() > 0 &&
      request.resource.data.product.title is string &&
      request.resource.data.product.title.size() > 0 &&
      request.resource.data.product.title.size() <= 200 &&
      request.resource.data.product.price is number &&
      request.resource.data.product.price >= 0;
  }

  function isSocialPostAuthorUpdate() {
    return isAuth() &&
      resource.data.authorId == request.auth.uid &&
      request.resource.data.authorId == resource.data.authorId &&
      request.resource.data.type == resource.data.type &&
      changedOnly(['content', 'updated_at']) &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 5000;
  }

  function isSocialPostLikeUpdate() {
    return isAuth() &&
      changedOnly(['likedBy', 'likeCount', 'updated_at']) &&
      request.resource.data.likedBy is list &&
      request.resource.data.likeCount is number &&
      request.resource.data.likeCount >= 0 &&
      request.resource.data.likeCount == request.resource.data.likedBy.size() &&
      (
        (!resource.data.likedBy.hasAll([request.auth.uid]) &&
          request.resource.data.likedBy.hasAll([request.auth.uid]) &&
          request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
          request.resource.data.likeCount == resource.data.likeCount + 1) ||
        (resource.data.likedBy.hasAll([request.auth.uid]) &&
          !request.resource.data.likedBy.hasAll([request.auth.uid]) &&
          request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
          request.resource.data.likeCount == resource.data.likeCount - 1)
      );
  }

  function isSocialPostShareUpdate() {
    return isAuth() &&
      changedOnly(['shareCount', 'updated_at']) &&
      request.resource.data.shareCount is number &&
      request.resource.data.shareCount == resource.data.shareCount + 1;
  }

  function isSocialPostCommentCounterUpdate() {
    return isAuth() &&
      changedOnly(['commentCount', 'updated_at']) &&
      request.resource.data.commentCount is number &&
      request.resource.data.commentCount == resource.data.commentCount + 1;
  }

  function isValidSocialCommentCreate(postId) {
    return isAuth() &&
      request.resource.data.postId == postId &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.authorName is string &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 2000;
  }

  function isSocialCommentAuthorUpdate() {
    return isAuth() &&
      resource.data.authorId == request.auth.uid &&
      changedOnly(['content', 'updated_at']) &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 2000;
  }

  function isValidConversationCreate() {
    return isAuth() &&
      request.resource.data.type in ['shop', 'support', 'aivy'] &&
      request.resource.data.participants is list &&
      request.resource.data.participants.size() >= 2 &&
      request.resource.data.participants.size() <= 10 &&
      request.auth.uid in request.resource.data.participants &&
      request.resource.data.partyName is string &&
      request.resource.data.partyName.size() > 0 &&
      request.resource.data.partyName.size() <= 120;
  }

  function isConversationParticipant(db, convoId) {
    return isAuth() &&
      exists(/databases/$(db)/documents/conversations/$(convoId)) &&
      request.auth.uid in get(/databases/$(db)/documents/conversations/$(convoId)).data.participants;
  }

  function isValidMessageCreate(db, convoId) {
    return isConversationParticipant(db, convoId) &&
      request.resource.data.senderId == request.auth.uid &&
      request.resource.data.content is string &&
      request.resource.data.content.size() > 0 &&
      request.resource.data.content.size() <= 4000;
  }

  match /databases/{database}/documents {

    // ─── User profiles ──────────────────────────────────────────────────
    match /users/{userId} {
      // Owner can read self; moderators/admin can read & list everyone.
      // Using `get, list` explicitly (instead of `read`) so the rule engine
      // evaluates the moderator branch before the per-doc check on list().
      allow get: if isAuth() && (request.auth.uid == userId || isModerator(database));
      allow list: if isModerator(database);

      allow create: if isAuth() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) ||
          request.resource.data.role == 'customer');
      allow update: if isAuth() &&
        (isOwner(database) || isAdminUserUpdate(database) || isOwnerProfileUpdate(userId));
      allow delete: if isOwner(database) ||
        (isAdmin(database) && resource.data.role != 'owner');
    }

    match /userProfiles/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    // ─── Products ───────────────────────────────────────────────────────
    match /products/{productId} {
      // Buyers can browse approved products only. Seller can read own working
      // catalog; moderators can read the moderation queue.
      allow get, list: if resource.data.status == 'approved' ||
        (isAuth() &&
          (isModerator(database) || resource.data.shopId == request.auth.uid));

      // Sellers can create products for their own shop.
      // Initial status must be "draft" or "pending" (seller cannot self-approve).
      allow create: if isAuth() &&
        request.resource.data.shopId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.basePrice is number &&
        request.resource.data.basePrice > 0 &&
        request.resource.data.status in ['draft', 'pending'];

      // Update rules:
      // - Admin/moderator can change anything (approve/reject)
      // - Owner can edit content but CANNOT set status to "approved" themselves
      allow update: if isAuth() && (
        isModerator(database) ||
        (resource.data.shopId == request.auth.uid &&
         request.resource.data.shopId == request.auth.uid &&
         request.resource.data.status in ['draft', 'pending', 'archived'])
      );

      // Only admin can delete
      allow delete: if isAdmin(database);
    }

    // ─── Orders ─────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customer, seller, admin, or moderator can read.
      // Moderator/admin can list all orders for the admin dashboard.
      allow get: if isAuth() &&
        (isModerator(database) ||
         resource.data.customerId == request.auth.uid ||
         resource.data.shopId == request.auth.uid ||
         resource.data.carrierId == request.auth.uid);
      allow list: if isAuth() &&
        (isModerator(database) ||
         resource.data.customerId == request.auth.uid ||
         resource.data.shopId == request.auth.uid ||
         resource.data.carrierId == request.auth.uid);

      // Authenticated buyers can create only initial order states. Payment
      // confirmation and fulfillment transitions should come from backend/admin
      // or the assigned seller/carrier.
      allow create: if isAuth() && isValidInitialOrder();

      // Order status updates by relevant parties
      allow update: if isAuth() &&
        (isAdmin(database) ||
         (resource.data.shopId == request.auth.uid &&
          request.resource.data.shopId == resource.data.shopId &&
          changedOnly(['status', 'updated_at', 'timeline', 'trackingNumber'])) ||
         (resource.data.carrierId == request.auth.uid &&
          changedOnly(['status', 'updated_at', 'timeline', 'trackingNumber'])) ||
         (resource.data.customerId == request.auth.uid &&
          resource.data.status in ['payment_pending', 'awaiting_confirm'] &&
          changedOnly(['status', 'updated_at', 'timeline'])));

      allow delete: if isAdmin(database);
    }

    // ─── Carts ──────────────────────────────────────────────────────────
    match /carts/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ─── Vendors (seller registration) ──────────────────────────────────
    match /vendors/{vendorId} {
      // Owner can read their own; moderators/admin can read & list all
      allow get, list: if isAuth() &&
        (isModerator(database) || resource.data.firebase_uid == request.auth.uid);

      // Any authenticated user can register as vendor (must use own UID)
      allow create: if isAuth() &&
        request.resource.data.firebase_uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Moderator/admin can update status; owner can update own profile when active
      allow update: if isAuth() &&
        (isModerator(database) ||
         isVendorOwnerProfileUpdate());

      allow delete: if isAdmin(database);
    }

    // ─── Audit logs (append-only) ───────────────────────────────────────
    match /auditLogs/{logId} {
      allow read, list: if isModerator(database);
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ─── Notifications ──────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if isAuth() && resource.data.user_id == request.auth.uid;
      allow create: if isModerator(database);
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ─── Counterfeit reports ────────────────────────────────────────────
    match /counterfeitReports/{reportId} {
      allow get: if isAuth() &&
        (isModerator(database) || resource.data.reporterId == request.auth.uid);
      allow list: if isModerator(database);

      allow create: if isAuth() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.productId is string &&
        request.resource.data.description is string;

      allow update: if isModerator(database);
      allow delete: if isAdmin(database);
    }

    // ─── Shop profiles ──────────────────────────────────────────────────
    match /shopProfiles/{shopId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == shopId;
      allow update: if isAuth() &&
        (isAdmin(database) || request.auth.uid == shopId);
      allow delete: if isAdmin(database);
    }

    // ─── Product verifications ──────────────────────────────────────────
    match /productVerifications/{verificationId} {
      allow read: if isAuth();
      allow create: if isModerator(database);
      allow update: if isModerator(database);
      allow delete: if isAdmin(database);
    }

    // ─── Payment methods ────────────────────────────────────────────────
    match /paymentMethods/{documentId} {
      allow read: if isAuth() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── Product reviews ────────────────────────────────────────────────
    // Visibility model:
    //   - public + approved → world-readable (product page, public profile)
    //   - private → only reviewer, shop owner of reviewed item, or admin
    //   - pending/rejected (any visibility) → reviewer + shop + admin
    match /productReviews/{reviewId} {
      allow read: if
        (resource.data.visibility == 'public' && resource.data.status == 'approved')
        || (isAuth() && (
             request.auth.uid == resource.data.userId
             || request.auth.uid == resource.data.shopId
             || isModerator(database)
           ));
      // Reviewer creates their own review with a valid rating + visibility.
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.visibility in ['public', 'private'] &&
        request.resource.data.status == 'pending';
      // Reviewer can change visibility/comment/photos/tags on their own review.
      // Moderator can change status (approve/reject) on any review.
      allow update: if isAuth() && (
        request.auth.uid == resource.data.userId
        || isModerator(database)
      );
      allow delete: if isAuth() &&
        (request.auth.uid == resource.data.userId || isAdmin(database));
    }

    // ─── Community news feed ───────────────────────────────────────────
    match /socialPosts/{postId} {
      allow read: if true;
      allow create: if isValidSocialPostCreate();
      allow update: if isModerator(database) ||
        isSocialPostAuthorUpdate() ||
        isSocialPostLikeUpdate() ||
        isSocialPostShareUpdate() ||
        isSocialPostCommentCounterUpdate();
      allow delete: if isAuth() &&
        (resource.data.authorId == request.auth.uid || isModerator(database));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidSocialCommentCreate(postId);
        allow update: if isModerator(database) || isSocialCommentAuthorUpdate();
        allow delete: if isAuth() &&
          (resource.data.authorId == request.auth.uid || isModerator(database));
      }
    }

    // ─── Affiliate referrals ────────────────────────────────────────────
    match /affiliateReferrals/{referralId} {
      allow read: if isAuth() &&
        (isAdmin(database) || resource.data.affiliateId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() &&
        (isAdmin(database) || resource.data.affiliateId == request.auth.uid);
      allow delete: if isAdmin(database);
    }

    // ─── Escrow payments ────────────────────────────────────────────────
    match /escrowPayments/{paymentId} {
      allow read: if isAuth() &&
        (isAdmin(database) ||
         resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller applications (legacy) ───────────────────────────────────
    match /sellerApplications/{applicationId} {
      allow read: if isAuth() &&
        (isModerator(database) || resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isModerator(database);
    }

    // ─── Conversations / Chat ───────────────────────────────────────────
    match /conversations/{convoId} {
      allow read: if isAuth() &&
        request.auth.uid in resource.data.participants;
      allow create: if isValidConversationCreate();
      allow update: if isAuth() &&
        request.auth.uid in resource.data.participants &&
        changedOnly(['lastMessage', 'lastMessageAt', 'unreadCount']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(database, convoId);
        allow create: if isValidMessageCreate(database, convoId);
        allow update, delete: if false;
      }
    }

    // ─── Banners (homepage slider) ──────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isModerator(database);
    }

    // ─── System settings ────────────────────────────────────────────────
    match /systemSettings/{settingsId} {
      allow read: if isModerator(database);
      allow create, update: if isAdmin(database);
      allow delete: if isOwner(database);
    }

    // ─── Seller finance: balance snapshot (1 doc / shop) ────────────────
    match /sellerBalances/{shopId} {
      allow read: if isAuth() &&
        (isAdmin(database) || request.auth.uid == shopId);
      // Only admin/backend may write balance — sellers cannot self-credit.
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller finance: payouts ────────────────────────────────────────
    match /sellerPayouts/{payoutId} {
      allow get, list: if isAuth() &&
        (isAdmin(database) || resource.data.shopId == request.auth.uid);
      // Payouts are created/updated by backend escrow worker (admin role).
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller finance: transactions (ledger) ──────────────────────────
    match /sellerTransactions/{txId} {
      allow get, list: if isAuth() &&
        (isAdmin(database) || resource.data.shopId == request.auth.uid);
      // Ledger is append-only and written by backend.
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller early-payout requests ───────────────────────────────────
    match /earlyPayoutRequests/{requestId} {
      allow get, list: if isAuth() &&
        (isAdmin(database) || resource.data.shopId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.shopId == request.auth.uid &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin(database);
    }

    // ─── Vouchers (seller-issued discount codes) ────────────────────────
    // Sellers create/update/delete vouchers for their own shop.
    // Buyers read only active vouchers. usedCount is admin-only (backend
    // increments it when an order consumes the voucher).
    match /vouchers/{voucherId} {
      allow get: if resource.data.isActive == true ||
        (isAuth() &&
          (isModerator(database) || resource.data.shopId == request.auth.uid));
      allow list: if resource.data.isActive == true ||
        (isAuth() &&
          (isModerator(database) || resource.data.shopId == request.auth.uid));

      allow create: if isAuth() &&
        request.resource.data.shopId == request.auth.uid &&
        request.resource.data.code is string &&
        request.resource.data.code.size() > 0 &&
        request.resource.data.code.size() <= 32 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.discountType in ['percent', 'fixed', 'shipping'] &&
        request.resource.data.value is number &&
        request.resource.data.value > 0 &&
        request.resource.data.minOrderValue is number &&
        request.resource.data.minOrderValue >= 0 &&
        request.resource.data.usageLimit is number &&
        request.resource.data.usageLimit >= 0 &&
        request.resource.data.usedCount == 0 &&
        request.resource.data.isActive is bool;

      // Seller can update anything except shopId/code/usedCount/createdAt.
      // Admin can update anything (including usedCount when redeeming).
      allow update: if isAuth() && (
        isAdmin(database) ||
        (resource.data.shopId == request.auth.uid &&
         request.resource.data.shopId == resource.data.shopId &&
         request.resource.data.code == resource.data.code &&
         request.resource.data.usedCount == resource.data.usedCount &&
         request.resource.data.createdAt == resource.data.createdAt)
      );

      allow delete: if isAuth() &&
        (isAdmin(database) || resource.data.shopId == request.auth.uid);
    }

    // ─── VAT invoices (seller-issued) ───────────────────────────────────
    match /vatInvoices/{invoiceId} {
      allow get, list: if isAuth() &&
        (isAdmin(database) || resource.data.shopId == request.auth.uid);
      // Sellers may issue invoices for their own shop. Series/invoiceNumber/
      // totals are sanitized client-side; signed e-invoice IDs come later
      // when integrating with VN tax authority (TCT) e-invoice provider.
      allow create: if isAuth() &&
        request.resource.data.shopId == request.auth.uid &&
        request.resource.data.invoiceNumber is string &&
        request.resource.data.total is number;
      // Issued invoices are immutable. Only admin can cancel.
      allow update, delete: if isAdmin(database);
    }

    // ─── Default deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
