rules_version = '2';
service cloud.firestore {
  // Define constants for roles
  
  // Hàm xác thực bổ sung - phải định nghĩa ở level service
  function validateProductData(data) {
    return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
           data.description is string && data.description.size() > 0 && data.description.size() < 1000 &&
           data.price is number && data.price > 0 &&
           data.shopId is string &&
           data.category is string &&
           data.images is list && data.images.size() > 0;
  }
  
  function validateProductUpdate(request, resource) {
    // Kiểm tra nếu chỉ các trường được phép cập nhật mới được thay đổi
    let changedFields = request.writeFields;
    let allowedChanges = ['price', 'quantity', 'status'];
    return changedFields.all(field, allowedChanges.has(field));
  }
  
  function validateOrderCreation(request) {
    return request.resource.data.customerId == request.auth.uid &&
           request.resource.data.items is list && 
           request.resource.data.items.size() > 0 &&
           request.resource.data.shippingAddress is map &&
           request.resource.data.totalAmount is number && 
           request.resource.data.totalAmount > 0;
  }
  
  function validateOrderUpdate(request, resource) {
    // Chỉ cho phép cập nhật trạng thái đơn hàng theo quy tắc kinh doanh
    let oldStatus = resource.data.status;
    let newStatus = request.resource.data.status;
    
    // Khách hàng chỉ có thể hủy đơn nếu trạng thái là 'pending' hoặc 'confirmed'
    if (request.auth.token.role == 'customer') {
      return oldStatus in ['pending', 'confirmed'] && newStatus == 'cancelled';
    }
    
    // Shop chỉ có thể cập nhật trạng thái theo luồng: pending -> confirmed -> shipped
    if (request.auth.token.role == 'shop') {
      return (oldStatus == 'pending' && newStatus == 'confirmed') ||
             (oldStatus == 'confirmed' && newStatus == 'shipped');
    }
    
    // Carrier chỉ có thể cập nhật sang trạng thái shipped hoặc delivered
    if (request.auth.token.role == 'carrier') {
      return newStatus in ['shipped', 'delivered'];
    }
    
    // Admin có thể cập nhật bất kỳ trạng thái nào
    return request.auth.token.role == 'admin';
  }
  
  function validateCounterfeitReport(data) {
    return data.productId is string &&
           data.description is string && data.description.size() > 10 &&
           data.evidenceImages is list && data.evidenceImages.size() > 0 &&
           data.reporterId is string;
  }
  
  function validateShopProfile(data) {
    return data.ownerId is string &&
           data.shopName is string && data.shopName.size() > 0 && data.shopName.size() < 50 &&
           data.description is string && data.description.size() < 500 &&
           data.businessLicense is string;
  }
  
  function validateShopProfileUpdate(request, resource) {
    // Cho phép cập nhật một số trường cụ thể
    let changedFields = request.writeFields;
    let allowedChanges = ['description', 'contactInfo', 'address', 'businessLicense'];
    return changedFields.all(field, allowedChanges.has(field));
  }
  
  function validatePaymentMethod(data) {
    return data.userId == request.auth.uid &&
           data.type in ['credit_card', 'debit_card', 'bank_transfer', 'mobile_wallet'] &&
           data.isDefault is bool;
  }
  
  function validateReview(data) {
    return data.productId is string &&
           data.userId is string &&
           data.rating is number && data.rating >= 1 && data.rating <= 5 &&
           data.comment is string && data.comment.size() > 0 && data.comment.size() < 500;
  }
  
  function validateSellerApplication(data) {
    return data.userId is string &&
           data.businessName is string &&
           data.businessRegistration is string &&
           data.description is string;
  }
  
  function isSpammingReports(userId) {
    // Kiểm tra nếu người dùng đã gửi nhiều báo cáo trong thời gian ngắn
    // (cần sử dụng Cloud Functions để thực hiện logic này)
    return false; // tạm thởi cho phép tất cả
  }
  
  function hasRecentlyReviewed(userId, productId) {
    // Kiểm tra nếu người dùng đã đánh giá sản phẩm này trong 30 ngày qua
    // (cần sử dụng Cloud Functions để thực hiện logic này)
    return false; // tạm thởi cho phép tất cả
  }
  
  match /databases/{database}/documents {
    // User profiles - chỉ người dùng được truy cập hồ sơ của chính họ
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // User profiles - chỉ người dùng được truy cập hồ sơ của chính họ
    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Products - cải thiện quy tắc bảo mật
    match /products/{productId} {
      // Everyone can read products but with size limitations
      allow read: if request.auth != null;
      
      // Only authenticated shop users can create/update products
      allow create: if request.auth != null 
        && (request.auth.token.role == 'shop' || request.auth.token.role == 'admin')
        && validateProductData(resource.data);
      allow update: if request.auth != null 
        && (request.auth.token.role == 'admin' 
          || (request.auth.token.role == 'shop' 
              && resource.data.shopId == request.auth.uid))
        && validateProductUpdate(request, resource);
              
      // Only admin can delete products
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Orders
    match /orders/{orderId} {
      // Customers can read their own orders
      allow read: if request.auth != null 
        && ((request.auth.token.role == 'customer' 
              && resource.data.customerId == request.auth.uid)
          || (request.auth.token.role == 'shop' 
              && resource.data.shopId == request.auth.uid)
          || (request.auth.token.role == 'admin')
          || (request.auth.token.role == 'carrier' 
              && resource.data.status in ['shipping', 'delivered']));
      
      // Customers can create orders for themselves
      allow create: if request.auth != null 
        && request.auth.token.role == 'customer'
        && validateOrderCreation(request);
        
      // Shops and admins can update order status
      allow update: if request.auth != null 
        && (request.auth.token.role == 'admin'
          || (request.auth.token.role == 'shop' 
              && resource.data.shopId == request.auth.uid)
          || (request.auth.token.role == 'carrier'
              && resource.data.status in ['shipping', 'delivered']))
          && validateOrderUpdate(request, resource);
              
      // Only admin can delete orders
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Cart - mỗi người dùng chỉ truy cập giỏ hàng của mình
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Counterfeit reports
    match /counterfeitReports/{reportId} {
      // Customers can read their own reports
      allow read: if request.auth != null 
        && (request.auth.token.role == 'admin' 
          || request.auth.token.role == 'moderator'
          || (request.auth.token.role == 'customer' 
              && resource.data.reporterId == request.auth.uid));
              
      // Anyone can create a report (with valid authentication) but with rate limiting
      allow create: if request.auth != null
        && validateCounterfeitReport(request.resource.data)
        && !isSpammingReports(request.auth.uid);
      
      // Admins and moderators can update reports
      allow update: if request.auth != null 
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'moderator');
        
      // Only admin can delete reports
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Shop profiles
    match /shopProfiles/{shopId} {
      // Everyone can read shop profiles (for public info)
      allow read: if request.auth != null;
      
      // Shop owners can create/update their own profile
      allow create: if request.auth != null 
        && request.auth.uid == shopId 
        && request.auth.token.role == 'shop'
        && validateShopProfile(request.resource.data);
      allow update: if request.auth != null 
        && request.auth.uid == shopId 
        && (request.auth.token.role == 'shop' || request.auth.token.role == 'admin')
        && validateShopProfileUpdate(request, resource);
        
      // Only admin can delete shop profiles
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Product verifications - cải thiện bảo mật, chỉ admin và functions được tạo
    match /productVerifications/{verificationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.role == 'moderator');
      allow update, delete: if request.auth != null && 
        (request.auth.token.role == 'admin' || 
         (request.auth.token.role == 'moderator' && 
          resource.data.status in ['pending', 'under_review']));
    }
    
    // Payment methods - chỉ người dùng được truy cập phương thức thanh toán của họ
    match /paymentMethods/{documentId} {
      // Read: user can read their own payment methods
      allow read: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Create: user can create payment methods for themselves
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid &&
        validatePaymentMethod(request.resource.data);
      
      // Update: user can update their own payment methods
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Delete: user can delete their own payment methods
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Product reviews
    match /productReviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        validateReview(request.resource.data) &&
        !hasRecentlyReviewed(request.auth.uid, request.resource.data.productId);
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.userId || request.auth.token.role == 'admin');
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId || request.auth.token.role == 'admin');
    }
    
    // Affiliate referrals
    match /affiliateReferrals/{referralId} {
      allow read, write: if request.auth != null && 
        (request.auth.token.role == 'admin' || 
         resource.data.affiliateId == request.auth.uid);
    }
    
    // Escrow payments - chỉ admin và người liên quan được truy cập
    match /escrowPayments/{paymentId} {
      allow read: if request.auth != null && 
        (request.auth.token.role == 'admin' ||
         resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if request.auth != null && 
        request.auth.token.role == 'admin';
    }
    
    // Seller applications - chỉ admin và moderators được đọc tất cả
    match /sellerApplications/{applicationId} {
      allow read: if request.auth != null && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.role == 'moderator' ||
         resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        validateSellerApplication(request.resource.data);
      allow update, delete: if request.auth != null && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.role == 'moderator');
    }
    
    // Vendors - seller registration records
    match /vendors/{vendorId} {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.role == 'moderator' ||
         resource.data.firebase_uid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.firebase_uid == request.auth.uid;
      allow update: if request.auth != null &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.role == 'moderator' ||
         (resource.data.firebase_uid == request.auth.uid &&
          resource.data.status == 'active'));
      allow delete: if request.auth != null &&
        request.auth.token.role == 'admin';
    }
    
    // Audit logs - append-only for compliance (NĐ 85/2021 - 24 month retention)
    match /auditLogs/{logId} {
      allow read: if request.auth != null &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.role == 'moderator');
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Notifications
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.user_id == request.auth.uid;
      allow create: if false;
      allow delete: if request.auth != null &&
        resource.data.user_id == request.auth.uid;
    }
  }
}