rules_version = '2';
service cloud.firestore {

  // ─── Role helpers ─────────────────────────────────────────────────────
  // Roles can come from EITHER:
  //   1) Custom claims set via Firebase Admin SDK (fast, no extra read)
  //   2) /users/{uid}.role document field (fallback for users provisioned
  //      via Firestore directly without Cloud Function side-effects)
  // We prefer custom claim; if absent we read the user doc. Document reads
  // billed against the rules quota are cached per request.

  function authedUid() {
    return request.auth.uid;
  }

  function claimRole() {
    return request.auth.token.role;
  }

  function docRole(db) {
    return get(/databases/$(db)/documents/users/$(authedUid())).data.role;
  }

  function hasClaim(role) {
    return request.auth != null && claimRole() == role;
  }

  function hasDocRole(db, role) {
    return request.auth != null &&
      exists(/databases/$(db)/documents/users/$(authedUid())) &&
      docRole(db) == role;
  }

  function isAdmin(db) {
    return hasClaim('admin') || hasDocRole(db, 'admin');
  }

  function isModerator(db) {
    return hasClaim('admin') || hasClaim('moderator') ||
      hasDocRole(db, 'admin') || hasDocRole(db, 'moderator');
  }

  function isAuth() {
    return request.auth != null;
  }

  match /databases/{database}/documents {

    // ─── User profiles ──────────────────────────────────────────────────
    match /users/{userId} {
      // Owner can read self; moderators/admin can read & list everyone.
      // Using `get, list` explicitly (instead of `read`) so the rule engine
      // evaluates the moderator branch before the per-doc check on list().
      allow get: if isAuth() && (request.auth.uid == userId || isModerator(database));
      allow list: if isModerator(database);

      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin(database));
      allow delete: if isAdmin(database);
    }

    match /userProfiles/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    // ─── Products ───────────────────────────────────────────────────────
    match /products/{productId} {
      // Public read (anyone can browse products — status filter is applied client-side)
      allow read: if true;

      // Sellers can create products for their own shop.
      // Initial status must be "draft" or "pending" (seller cannot self-approve).
      allow create: if isAuth() &&
        request.resource.data.shopId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.basePrice is number &&
        request.resource.data.basePrice > 0 &&
        request.resource.data.status in ['draft', 'pending'];

      // Update rules:
      // - Admin/moderator can change anything (approve/reject)
      // - Owner can edit content but CANNOT set status to "approved" themselves
      allow update: if isAuth() && (
        isModerator(database) ||
        (resource.data.shopId == request.auth.uid &&
         request.resource.data.shopId == request.auth.uid &&
         request.resource.data.status in ['draft', 'pending', 'archived'])
      );

      // Only admin can delete
      allow delete: if isAdmin(database);
    }

    // ─── Orders ─────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Customer, seller, admin, or moderator can read.
      // Moderator/admin can list all orders for the admin dashboard.
      allow get: if isAuth() &&
        (isModerator(database) ||
         resource.data.customerId == request.auth.uid ||
         resource.data.shopId == request.auth.uid ||
         resource.data.carrierId == request.auth.uid);
      allow list: if isModerator(database);

      // Authenticated users can create orders
      allow create: if isAuth() &&
        request.resource.data.customerId == request.auth.uid;

      // Order status updates by relevant parties
      allow update: if isAuth() &&
        (isAdmin(database) ||
         resource.data.shopId == request.auth.uid ||
         resource.data.carrierId == request.auth.uid ||
         (resource.data.customerId == request.auth.uid &&
          resource.data.status in ['pending', 'confirmed']));

      allow delete: if isAdmin(database);
    }

    // ─── Carts ──────────────────────────────────────────────────────────
    match /carts/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ─── Vendors (seller registration) ──────────────────────────────────
    match /vendors/{vendorId} {
      // Owner can read their own; moderators/admin can read & list all
      allow get: if isAuth() &&
        (isModerator(database) || resource.data.firebase_uid == request.auth.uid);
      allow list: if isModerator(database);

      // Any authenticated user can register as vendor (must use own UID)
      allow create: if isAuth() &&
        request.resource.data.firebase_uid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Moderator/admin can update status; owner can update own profile when active
      allow update: if isAuth() &&
        (isModerator(database) ||
         (resource.data.firebase_uid == request.auth.uid &&
          resource.data.status == 'active'));

      allow delete: if isAdmin(database);
    }

    // ─── Audit logs (append-only) ───────────────────────────────────────
    match /auditLogs/{logId} {
      allow read, list: if isModerator(database);
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ─── Notifications ──────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if isAuth() && resource.data.user_id == request.auth.uid;
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // ─── Counterfeit reports ────────────────────────────────────────────
    match /counterfeitReports/{reportId} {
      allow get: if isAuth() &&
        (isModerator(database) || resource.data.reporterId == request.auth.uid);
      allow list: if isModerator(database);

      allow create: if isAuth() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.productId is string &&
        request.resource.data.description is string;

      allow update: if isModerator(database);
      allow delete: if isAdmin(database);
    }

    // ─── Shop profiles ──────────────────────────────────────────────────
    match /shopProfiles/{shopId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == shopId;
      allow update: if isAuth() &&
        (isAdmin(database) || request.auth.uid == shopId);
      allow delete: if isAdmin(database);
    }

    // ─── Product verifications ──────────────────────────────────────────
    match /productVerifications/{verificationId} {
      allow read: if isAuth();
      allow create: if isModerator(database);
      allow update: if isModerator(database);
      allow delete: if isAdmin(database);
    }

    // ─── Payment methods ────────────────────────────────────────────────
    match /paymentMethods/{documentId} {
      allow read: if isAuth() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── Product reviews ────────────────────────────────────────────────
    match /productReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if isAuth() &&
        (request.auth.uid == resource.data.userId || isAdmin(database));
      allow delete: if isAuth() &&
        (request.auth.uid == resource.data.userId || isAdmin(database));
    }

    // ─── Affiliate referrals ────────────────────────────────────────────
    match /affiliateReferrals/{referralId} {
      allow read: if isAuth() &&
        (isAdmin(database) || resource.data.affiliateId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() &&
        (isAdmin(database) || resource.data.affiliateId == request.auth.uid);
      allow delete: if isAdmin(database);
    }

    // ─── Escrow payments ────────────────────────────────────────────────
    match /escrowPayments/{paymentId} {
      allow read: if isAuth() &&
        (isAdmin(database) ||
         resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if isAdmin(database);
    }

    // ─── Seller applications (legacy) ───────────────────────────────────
    match /sellerApplications/{applicationId} {
      allow read: if isAuth() &&
        (isModerator(database) || resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isModerator(database);
    }

    // ─── Conversations / Chat ───────────────────────────────────────────
    match /conversations/{convoId} {
      allow read: if isAuth() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuth();
      allow update: if isAuth() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if false;
      }
    }

    // ─── Banners (homepage slider) ──────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isModerator(database);
    }

    // ─── Default deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
