# ACFMart - Functions environment variables (project ecommerce-acf)
# Quy ước đơn vị:
#   *_RATE  → decimal (0.05 = 5%)
#   *_BPS   → basis points (500 = 5%)

# --- Phí sàn (platform commission, áp dụng cho tất cả seller) ---
# Decimal. Code đọc qua defineString trong functions/src/finance.ts.
PLATFORM_COMMISSION_RATE=0.02

# --- Phí cổng thanh toán (VNPay/Momo/ZaloPay/Stripe) ---
# Decimal.
PAYMENT_GATEWAY_FEE_RATE=0.02

# --- Escrow hold (ngày giữ tiền sau khi giao hàng) ---
ESCROW_HOLD_DAYS=7

# --- Hoa hồng affiliate mặc định ---
# Basis points. KHÁC ĐƠN VỊ với PLATFORM_COMMISSION_RATE (decimal).
# Thứ tự ưu tiên trong functions/src/affiliate.ts:
#   affiliateLinks.commission_bps  → affiliateProfile.default_commission_bps
#   → env này → fallback hardcode 500.
# Khoảng khuyến nghị: 200 (2%) – 500 (5%).
AFFILIATE_DEFAULT_COMMISSION_BPS=300
