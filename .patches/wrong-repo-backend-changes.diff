+  async getBatchQrCodes(sellerId: string, batchId: string, params: { page: number; limit: number }) {
+    const batch = await prisma.qRBatch.findUnique({
+      where: { id: batchId },
+    });
+
+    if (!batch || batch.sellerId !== sellerId) {
+      throw new Error('Batch QR không tồn tại');
+    }
+
+    const { page, limit } = params;
+    const skip = (page - 1) * limit;
+
+    const [data, total] = await Promise.all([
+      prisma.qRVerification.findMany({
+        where: { batchId },
+        orderBy: { createdAt: 'asc' },
+        skip,
+        take: limit,
+        select: {
+          id: true,
+          qrCode: true,
+          serialNumber: true,
+          isActive: true,
+          scanCount: true,
+          lastScannedAt: true,
+          createdAt: true,
+        },
+      }),
+      prisma.qRVerification.count({ where: { batchId } }),
+    ]);
+
+    const APP_URL = process.env.NEXT_PUBLIC_APP_URL || 'https://acfmart.vn';
+
+    return {
+      data: data.map((qr) => ({
+        ...qr,
+        verifyUrl: `${APP_URL}/qr-verify/${qr.qrCode}`,
+      })),
+      total,
+      page,
+      limit,
+      batch: {
+        id: batch.id,
+        productId: batch.productId,
+        quantity: batch.quantity,
+        status: batch.status,
+      },
+    };
+  },
+
+  async createPrintJob(
