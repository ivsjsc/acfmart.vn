# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acfmart_payments
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379

# PSP Configuration - Sandbox
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/
VNPAY_TMNCODE=test_vnpay
VNPAY_HASHSECRET=test_secret
VNPAY_RETURN_URL=http://localhost:3001/api/v1/payments/callback

MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/
MOMO_PARTNER_CODE=test_momo
MOMO_ACCESS_KEY=test_access
MOMO_SECRET_KEY=test_secret
MOMO_RETURN_URL=http://localhost:3001/api/v1/payments/momo/callback

# PSP Configuration - Production
VNPAY_API_URL_PROD=https://pay.vnpayment.vn/merchant_webapi/api/
VNPAY_TMNCODE_PROD=
VNPAY_HASHSECRET_PROD=

MOMO_API_URL_PROD=https://api.momo.vn/v2/gateway/api/
MOMO_PARTNER_CODE_PROD=
MOMO_ACCESS_KEY_PROD=
MOMO_SECRET_KEY_PROD=

# Security Configuration
JWT_SECRET=acfmart_escrow_secret_key
JWT_EXPIRES_IN=24h
WEBHOOK_SECRET=acfmart_webhook_secret

# Escrow Configuration
ESCROW_HOLD_DURATION_HOURS=24
MAX_REFUND_DAYS=30

# Logging
LOG_LEVEL=info