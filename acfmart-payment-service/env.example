# ┌─────────────────────────────────────────────────────────────────────────┐
# │  ACFMart Payment Service - Environment Variables                        │
# │  Sao chép file này thành `.env` và điền giá trị thực tế trước khi chạy. │
# │  Mọi giá trị "replace-..." là placeholder - KHÔNG dùng trong production.│
# └─────────────────────────────────────────────────────────────────────────┘

# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
SERVICE_NAME=acfmart-payment-service
PUBLIC_BASE_URL=http://localhost:3001

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acfmart_payments
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000

# ─── Redis (cho idempotency cache + rate limit) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=acfmart:pay:

# ─── Bảo mật ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-this-with-a-32-char-random-secret
INTERNAL_API_KEY=replace-with-internal-server-token
ENCRYPTION_KEY=replace-with-32-byte-hex-key
WEBHOOK_REPLAY_WINDOW_SEC=300

# ─── Escrow ──────────────────────────────────────────────────────────────
ESCROW_HOLD_DURATION_HOURS=72
ESCROW_AUTO_RELEASE_AFTER_DAYS=7
PLATFORM_COMMISSION_RATE=0.05
PAYMENT_GATEWAY_FEE_RATE=0.022

# ─── VNPay (sandbox) ─────────────────────────────────────────────────────
VNPAY_TMNCODE=
VNPAY_HASHSECRET=
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:3001/api/v1/webhooks/vnpay

# ─── VNPay (production - chỉ điền khi go live) ──────────────────────────
VNPAY_TMNCODE_PROD=
VNPAY_HASHSECRET_PROD=
VNPAY_API_URL_PROD=https://pay.vnpay.vn/vpcpay.html

# ─── MoMo (sandbox) ──────────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/payment/momo/return
MOMO_IPN_URL=http://localhost:3001/api/v1/webhooks/momo

# ─── MoMo (production) ──────────────────────────────────────────────────
MOMO_PARTNER_CODE_PROD=
MOMO_ACCESS_KEY_PROD=
MOMO_SECRET_KEY_PROD=
MOMO_API_URL_PROD=https://payment.momo.vn/v2/gateway/api/create

# ─── ZaloPay ─────────────────────────────────────────────────────────────
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_API_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_RETURN_URL=http://localhost:3000/payment/zalopay/return
ZALOPAY_CALLBACK_URL=http://localhost:3001/api/v1/webhooks/zalopay

# ─── Stripe (cho thị trường quốc tế khi có hợp đồng) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/stripe/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/stripe/cancel

# ─── Shipping webhook secret (GHN / GHTK) ───────────────────────────────
GHN_WEBHOOK_SECRET=
GHTK_WEBHOOK_SECRET=

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WEBHOOK_MAX=600

# ─── Reconciliation ──────────────────────────────────────────────────────
VNPAY_RECONCILIATION_FILE_PATH=/tmp/vnpay_recon.csv
SLACK_WEBHOOK_URL=

# ─── Allowed origins (CORS) ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://acfmart.vn
