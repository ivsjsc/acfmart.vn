rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Seller document uploads - authenticated users can upload to their own folder
    // Accepts: images, PDF, and common document formats (CCCD, giấy phép KD, etc.)
    match /seller-docs/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024;
    }
    
    // Product images - public read, authenticated write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Product images uploaded by sellers from the product submission form.
    // Path: product-images/{shopId}/{timestamp}_{filename}
    // shopId = seller's Firebase UID (same constraint as Firestore rules).
    match /product-images/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == shopId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Return/refund evidence uploaded by the buyer before creating a
    // returnRequests document.
    match /return-evidence/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Shop assets (logos, banners)
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == shopId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
