{
  "name": "acfmart-app",
  "version": "1.0.0",
  "description": "acfmart - Sàn thương mại điện tử chống hàng giả do IVS JSC vận hành",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist node_modules/.cache",
    "check-alias-sync": "node scripts/check-alias-sync.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest",
    "firebase:deploy": "yarn build && firebase deploy --only hosting:acfmart --project ecommerce-acf"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@medusajs/js-sdk": "^2.0.0",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "firebase": "^10.13.0",
    "groq-sdk": "^0.7.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.454.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.5.16",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "undici": "^6.24.0"
  },
  "keywords": [
    "acfmart",
    "e-commerce",
    "anti-counterfeit",
    "vietnam",
    "medusa"
  ],
  "author": "ACF Team",
  "license": "MIT",
  "private": true
}
