# --- Medusa backend (commerce) ---
VITE_MEDUSA_BACKEND_URL=http://localhost:9000
VITE_MEDUSA_PUBLISHABLE_KEY=pk_xxx
VITE_MEDUSA_REGION_ID=reg_xxx

# --- Firebase (auth, storage) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_PHONE_TEST_TOKEN=

# --- Zalo Login (custom Firebase Auth token via Cloud Function) ---
VITE_ZALO_APP_ID=
VITE_ZALO_AUTH_FUNCTION_URL=https://asia-southeast1-ecommerce-acf.cloudfunctions.net/zaloAuth
# Server-side secret only. Set with:
# npx -y firebase-tools@latest functions:secrets:set ZALO_APP_SECRET --project ecommerce-acf
# --- Aivy chatbot (Google Gemini) ---
# Tạo key tại: https://aistudio.google.com/apikey
VITE_GOOGLE_AI_API_KEY=AIzaSy...
VITE_GEMINI_MODEL=gemini-pro

# --- Shipping providers ---
# GHN: https://5sao.ghn.dev/
VITE_GHN_TOKEN=
VITE_GHN_SHOP_ID=

# GHTK: https://docs.giaohangtietkiem.vn/
VITE_GHTK_TOKEN=

# J&T (cần backend ký HMAC, không xài client trực tiếp)
VITE_JNT_API_KEY=
VITE_JNT_SECRET=

# --- Payment providers ---
# IMPORTANT: VNPay/Momo/ZaloPay đều cần backend endpoint /api/payment/*/init
# để ký HMAC – KHÔNG bao giờ expose secretKey ra browser.

# VNPay: https://sandbox.vnpayment.vn/
VITE_VNPAY_TMN_CODE=
VITE_VNPAY_HASH_SECRET=

# Momo: https://developers.momo.vn/
VITE_MOMO_PARTNER_CODE=
VITE_MOMO_ACCESS_KEY=
VITE_MOMO_SECRET_KEY=

# ZaloPay: https://docs.zalopay.vn/
VITE_ZALOPAY_APP_ID=
VITE_ZALOPAY_KEY1=
VITE_ZALOPAY_KEY2=
