{
  "name": "acfmart-backend",
  "version": "1.0.0",
  "description": "Medusa v2 backend for ACFMart e-commerce platform",
  "author": "IVS JSC",
  "license": "MIT",
  "keywords": [
    "medusa",
    "ecommerce",
    "acfmart",
    "vietnam",
    "shopping"
  ],
  "scripts": {
    "build": "node ./scripts/run-medusa-cli.cjs build",
    "start": "node ./scripts/run-medusa-cli.cjs start",
    "dev": "node ./scripts/run-medusa-cli.cjs develop",
    "seed": "node ./scripts/run-medusa-cli.cjs exec ./src/scripts/seed.ts",
    "migrate": "node ./scripts/run-medusa-cli.cjs db:migrate",
    "db:setup": "node ./scripts/run-medusa-cli.cjs db:setup",
    "cli": "node ./scripts/run-medusa-cli.cjs"
  },
  "dependencies": {
