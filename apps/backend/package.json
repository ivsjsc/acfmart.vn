    "@medusajs/sales-channel": "^2.0.0",
    "@medusajs/tax": "^2.0.0",
    "typeorm": "^0.3.16",
    "pg": "^8.11.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.1",
    "jwks-rsa": "^3.0.1",
    "uuid": "^9.0.0",
    "axios": "^1.4.0",
    "redis": "^4.6.7",
