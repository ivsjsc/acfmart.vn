{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "pretty": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": false,
    "importHelpers": true,
    "verbatimModuleSyntax": false,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "plugins": [
      {
        "transform": "@medusajs/medusa/dist/utils/babel-transpiler.js",
        "resolveJsonModule": true,
        "module": "commonjs"
      }
    ]
  },
  "ts-node": {
    "transpileOnly": true,
    "require": [
      "tsconfig-paths/register"
    ],
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".cache",
    ".test",
    "**/__tests__/**/*",
    "**/__mocks__/**/*",
    "**/templates/**/*",
    "**/temp/**/*",
    "jest.config.js",
    "tsconfig.spec.json",
    "medusa-config.ts"
  ]
}
